@model EDom.Application.Rental.TenantSettlementOverview
@using EDom.Domain.Rental
@{
    ViewData["Title"] = "Rozliczenia lokatorów";
    var today = DateOnly.FromDateTime(DateTime.Today);
    var monthKey = DateTime.Today.ToString("yyyy-MM");
    string Money(long minor, string currency) => $"{minor / 100m:0.00} {currency}";
    string StatusPl(string status) => status switch
    {
        TenantSettlementStatuses.Draft => "Projekt",
        TenantSettlementStatuses.AwaitingData => "Brak danych",
        TenantSettlementStatuses.ReadyForApproval => "Gotowe do zatwierdzenia",
        TenantSettlementStatuses.Approved => "Zatwierdzone",
        TenantSettlementStatuses.Published => "Opublikowane",
        TenantSettlementStatuses.PartiallyPaid => "Częściowo opłacone",
        TenantSettlementStatuses.Paid => "Opłacone",
        TenantSettlementStatuses.Overdue => "Zaległe",
        TenantSettlementStatuses.Corrected => "Skorygowane",
        TenantSettlementStatuses.PaidLate => "Opłacone po terminie",
        _ => status
    };
    string LinePl(string type) => type switch
    {
        TenantSettlementLineTypes.Rent => "Czynsz",
        TenantSettlementLineTypes.Electricity => "Prąd",
        TenantSettlementLineTypes.Water => "Woda / ścieki",
        TenantSettlementLineTypes.Gas => "Gaz",
        TenantSettlementLineTypes.Waste => "Odpady",
        TenantSettlementLineTypes.Pellet => "Pellet / ogrzewanie",
        TenantSettlementLineTypes.Asset => "Sprzęt",
        TenantSettlementLineTypes.Repair => "Naprawa",
        TenantSettlementLineTypes.LateFee => "Opłata za opóźnienie",
        TenantSettlementLineTypes.Correction => "Korekta",
        TenantSettlementLineTypes.Adjustment => "Inna pozycja",
        _ => type
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Rozliczenia lokatorów</h1>
        <div class="text-muted">Czynsz, media, płatności, nadpłaty, uzgodnienia i opłaty za opóźnienie.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Rental" asp-action="Index">← Umowy najmu</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

@if (Model.CanManage)
{
    <div class="card mb-4">
        <div class="card-header"><strong>Przygotuj miesięczne rozliczenie</strong></div>
        <div class="card-body">
            <form asp-action="Build" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-lg-7">
                    <label class="form-label">Umowa / lokator / pokój</label>
                    <select name="leaseContractId" class="form-select" required>
                        <option value="">-- wybierz aktywną umowę --</option>
                        @foreach (var c in Model.Contracts)
                        {
                            <option value="@c.ContractId">@c.TenantName — @c.RoomName (@c.Status)</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3"><label class="form-label">Miesiąc</label><input name="periodKey" value="@monthKey" pattern="\d{4}-\d{2}" class="form-control" required /></div>
                <div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary w-100">Przelicz projekt</button></div>
            </form>
            <div class="small text-muted mt-2">Projekt pobiera czynsz z umowy, zatwierdzone alokacje mediów, stawkę odpadów i udział w pellecie. Brak źródła blokuje publikację.</div>
        </div>
    </div>

    <div class="alert alert-warning mb-4">
        <strong>Operacje wysokiego ryzyka (R4) są chronione przez MFA.</strong>
        Tworzenie reguł opłat za opóźnienie, ręczne przeliczanie zaległości oraz korekty pozostają zabezpieczone i nie są uruchamiane z interfejsu do czasu podłączenia rzeczywistego MFA/reauth. PKG-013 nie omija tej polityki bezpieczeństwa.
        @if (Model.LateFeeRules.Count > 0)
        {
            <div class="small mt-2"><strong>Aktywne / historyczne reguły opłat:</strong> @Model.LateFeeRules.Count</div>
        }
    </div>
}

@if (Model.Settlements.Count == 0)
{
    <div class="alert alert-secondary">Nie ma jeszcze rozliczeń widocznych dla tego konta.</div>
}

@foreach (var s in Model.Settlements)
{
    var canEditDraft = Model.CanManage && (s.Status == TenantSettlementStatuses.Draft || s.Status == TenantSettlementStatuses.AwaitingData || s.Status == TenantSettlementStatuses.ReadyForApproval);
    var canPublish = Model.CanManage && s.Status == TenantSettlementStatuses.Approved;
    var canSubmit = Model.IsTenant && s.PayerPersonId != Guid.Empty && (s.Status == TenantSettlementStatuses.Published || s.Status == TenantSettlementStatuses.PartiallyPaid || s.Status == TenantSettlementStatuses.Overdue);
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div><strong>@s.TenantName — @s.PeriodKey</strong><div class="small text-muted">@s.RoomName · termin @s.DueDate.ToString("yyyy-MM-dd")</div></div>
            <span class="badge @(s.Status == TenantSettlementStatuses.Paid ? "text-bg-success" : s.Status == TenantSettlementStatuses.Overdue || s.Status == TenantSettlementStatuses.AwaitingData ? "text-bg-danger" : "text-bg-secondary")">@StatusPl(s.Status)</span>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3"><div class="border rounded p-2"><small class="text-muted">Bieżący miesiąc</small><div class="fw-bold">@Money(s.CurrentPeriodMinor,s.CurrencyCode)</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><small class="text-muted">Poprzednia zaległość</small><div class="fw-bold">@Money(s.PreviousBalanceMinor,s.CurrencyCode)</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><small class="text-muted">Zatwierdzone wpłaty</small><div class="fw-bold">@Money(s.PaidMinor,s.CurrencyCode)</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded p-2"><small class="text-muted">Pozostało</small><div class="fw-bold">@Money(s.RemainingMinor,s.CurrencyCode)</div></div></div>
            </div>

            <div class="table-responsive mb-3"><table class="table table-sm align-middle"><thead><tr><th>Pozycja</th><th>Źródło</th><th>Status danych</th><th class="text-end">Kwota</th></tr></thead><tbody>
            @foreach(var line in s.Lines)
            {
                <tr><td>@LinePl(line.LineType)</td><td><small>@line.SourceType</small></td><td>@(line.Status == TenantSettlementLineStatuses.AwaitingData ? "Brak danych" : "Gotowe")</td><td class="text-end">@Money(line.AmountMinor,line.CurrencyCode)</td></tr>
            }
            <tr class="table-light"><td colspan="3"><strong>Razem do rozliczenia</strong></td><td class="text-end"><strong>@Money(s.TotalDueMinor,s.CurrencyCode)</strong></td></tr>
            </tbody></table></div>

            @if (Model.CanManage)
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @if (s.Status == TenantSettlementStatuses.ReadyForApproval || s.Status == TenantSettlementStatuses.Draft)
                    {
                        <form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="settlementId" value="@s.Id"/><button class="btn btn-success btn-sm">Zatwierdź</button></form>
                    }
                    @if (canPublish)
                    {
                        <form asp-action="Publish" method="post">@Html.AntiForgeryToken()<input type="hidden" name="settlementId" value="@s.Id"/><button class="btn btn-primary btn-sm">Opublikuj lokatorowi</button></form>
                    }
                    @if (s.Status == TenantSettlementStatuses.AwaitingData)
                    {
                        <span class="text-danger small align-self-center">Publikacja zablokowana — uzupełnij źródła mediów.</span>
                    }
                </div>
            }

            @if (canEditDraft)
            {
                <details class="mb-3"><summary>Dodaj sprzęt, naprawę lub korektę</summary><form asp-action="AddLine" method="post" class="row g-2 mt-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="settlementId" value="@s.Id"/><input type="hidden" name="currencyCode" value="@s.CurrencyCode"/>
                    <div class="col-md-3"><select name="lineType" class="form-select form-select-sm"><option value="Asset">Sprzęt</option><option value="Repair">Naprawa</option><option value="Adjustment">Inna pozycja</option><option value="Correction">Korekta (+/-)</option></select></div>
                    <div class="col-md-2"><input name="amount" type="number" step="0.01" class="form-control form-control-sm" placeholder="Kwota" required/></div>
                    <div class="col-md-2"><input name="sourceType" value="Manual" class="form-control form-control-sm" required/></div>
                    <div class="col-md-4"><input name="calculationNote" class="form-control form-control-sm" placeholder="Źródło / opis / powód"/></div>
                    <div class="col-md-1"><button class="btn btn-outline-secondary btn-sm w-100">Dodaj</button></div>
                </form></details>
            }

            @if (Model.CanManage && s.PublishedAtUtc.HasValue)
            {
                <div class="small text-muted mb-3">Jawna korekta opublikowanego rozliczenia jest operacją R4 i wymaga MFA. Mechanizm backendowy zachowuje pełną historię, ale akcja w UI pozostaje wyłączona do czasu podłączenia MFA/reauth.</div>
            }

            @if (canSubmit)
            {
                <div class="border rounded p-3 mb-3">
                    <strong>Zgłoś wpłatę</strong>
                    <form asp-action="SubmitPayment" method="post" enctype="multipart/form-data" class="row g-2 mt-1">
                        @Html.AntiForgeryToken()<input type="hidden" name="settlementId" value="@s.Id"/><input type="hidden" name="currencyCode" value="@s.CurrencyCode"/>
                        <div class="col-md-2"><label class="form-label small">Kwota</label><input name="amount" type="number" step="0.01" min="0.01" class="form-control" required/></div>
                        <div class="col-md-3"><label class="form-label small">Data i godzina</label><input name="declaredPaidAtLocal" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="form-control" required/></div>
                        <div class="col-md-2"><label class="form-label small">Forma</label><select name="paymentMethod" class="form-select"><option value="Bank">Przelew</option><option value="Cash">Gotówka</option></select></div>
                        <div class="col-md-3"><label class="form-label small">Potwierdzenie (opcjonalne)</label><input name="proof" type="file" class="form-control"/></div>
                        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Zgłoś</button></div>
                    </form>
                    <div class="small text-muted mt-2">Zgłoszenie nie zwiększa salda rachunku domowego. Księgowanie następuje dopiero po zatwierdzeniu.</div>
                </div>
            }

            @if (s.Submissions.Count > 0)
            {
                <h2 class="h6">Zgłoszenia wpłat</h2>
                <div class="table-responsive mb-3"><table class="table table-sm"><thead><tr><th>Data</th><th>Forma</th><th>Kwota</th><th>Status</th>@if(Model.CanManage){<th>Decyzja</th>}</tr></thead><tbody>
                @foreach(var payment in s.Submissions)
                {
                    <tr><td>@payment.DeclaredPaidAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@(payment.PaymentMethod=="Cash"?"Gotówka":"Przelew")</td><td>@Money(payment.AmountMinor,payment.CurrencyCode)</td><td>@payment.Status</td>
                    @if(Model.CanManage){<td>@if(payment.Status=="Pending"){
                        <div class="d-flex flex-wrap gap-1"><form asp-action="ApprovePayment" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="submissionId" value="@payment.Id"/><input name="approvedAmount" type="number" step="0.01" min="0.01" placeholder="kwota (puste=całość)" class="form-control form-control-sm" style="max-width:150px"/><button class="btn btn-success btn-sm">Zatwierdź</button></form>
                        <form asp-action="RejectPayment" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="submissionId" value="@payment.Id"/><input name="reason" class="form-control form-control-sm" placeholder="Powód" required/><button class="btn btn-outline-danger btn-sm">Odrzuć</button></form></div>
                    } else { @payment.DecisionReason }</td>}</tr>
                }
                </tbody></table></div>
            }

            @if (Model.CanManage && s.RemainingMinor > 0 && s.PublishedAtUtc.HasValue)
            {
                <details class="mb-3"><summary>Uzgodnij późniejszą dopłatę</summary><form asp-action="Arrangement" method="post" class="row g-2 mt-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="settlementId" value="@s.Id"/>
                    <div class="col-md-2"><input name="declaredAmount" type="number" step="0.01" min="0.01" max="@(s.RemainingMinor/100m)" class="form-control form-control-sm" placeholder="Kwota" required/></div>
                    <div class="col-md-2"><input name="agreedDate" type="date" class="form-control form-control-sm" required/></div>
                    <div class="col-md-3"><input name="description" class="form-control form-control-sm" placeholder="Ustalenie"/></div>
                    <div class="col-md-3"><input name="sourceInformation" class="form-control form-control-sm" placeholder="Źródło ustalenia"/></div>
                    <div class="col-md-1 form-check d-flex align-items-center"><input name="visibleToTenant" value="true" type="checkbox" class="form-check-input" checked/><label class="form-check-label ms-1">Widoczne</label></div>
                    <div class="col-md-1"><button class="btn btn-outline-primary btn-sm w-100">Zapisz</button></div>
                </form><div class="small text-muted mt-1">Uzgodnienie nie zmniejsza należności do czasu zatwierdzenia rzeczywistej wpłaty.</div></details>
            }

            @if (s.Arrangements.Count > 0)
            {
                <div class="small mb-2"><strong>Uzgodnienia:</strong> @foreach(var a in s.Arrangements){<span class="badge text-bg-light border me-1">@a.AgreedDate.ToString("yyyy-MM-dd") · @Money(a.DeclaredAmountMinor,s.CurrencyCode) · @a.Status</span>}</div>
            }

            @if (s.LateFees.Count > 0)
            {
                <h2 class="h6 mt-3">Opłaty za opóźnienie <span class="text-muted">(oddzielnie od należności głównej)</span></h2>
                <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Do dnia</th><th>Dni</th><th>Podstawa</th><th>Opłata</th><th>Status</th></tr></thead><tbody>
                @foreach(var fee in s.LateFees){<tr><td>@fee.CalculatedThrough.ToString("yyyy-MM-dd")</td><td>@fee.DaysLate</td><td>@Money(fee.PrincipalSnapshotMinor,fee.CurrencyCode)</td><td>@Money(fee.ChargeAmountMinor,fee.CurrencyCode)</td><td>@fee.Status</td></tr>}
                </tbody></table></div>
            }
        </div>
    </div>
}

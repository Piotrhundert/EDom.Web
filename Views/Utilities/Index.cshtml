@using EDom.Domain.Utilities
@using EDom.Domain.Property
@model EDom.Web.Models.UtilitiesPageViewModel

@{
    ViewData["Title"] = "Media";

    var nowLocal = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
    var today = DateOnly.FromDateTime(DateTime.Today);
    var meterById = Model.Overview.Meters.ToDictionary(x => x.Id);
    var contractById = Model.Overview.Contracts.ToDictionary(x => x.Id);

    string Money(long minor, string currency) => $"{minor / 100m:N2} {currency}";

    string MediumLabel(string? medium) => medium switch
    {
        "Electricity" => "Prąd",
        "Water" => "Woda",
        "Gas" => "Gaz",
        "Waste" => "Odpady",
        "Heating" => "Ogrzewanie",
        _ => medium ?? "Inne"
    };

    string ReadingStatus(string? status) => status switch
    {
        ReadingStatuses.Submitted => "Do zatwierdzenia",
        ReadingStatuses.Approved => "Zatwierdzony",
        "Rejected" => "Odrzucony",
        _ => status ?? "—"
    };

    string ReadingValue(Guid readingId)
    {
        var values = Model.Overview.ReadingValues
            .Where(x => x.MeterReadingId == readingId)
            .ToList();

        if (values.Count == 0)
        {
            return "—";
        }

        return string.Join(
            " · ",
            values.Select(x =>
                $"{x.ZoneCode}: {x.ValueScaled / (decimal)Math.Pow(10, x.Scale):N3} {x.UnitCode}"));
    }

    var submittedCount = Model.Overview.Readings.Count(x => x.Status == ReadingStatuses.Submitted);
}

<link rel="stylesheet" href="~/css/utilities-organized.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/submeter-tenant-settlement.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/utility-invoice-distribution.css" asp-append-version="true" />

<section class="utilities-hero">
    <div>
        <div class="utilities-eyebrow">MEDIA I LICZNIKI</div>
        <h1>Media</h1>
        <p>
            Odczyty liczników na pierwszym miejscu. Umowy, faktury i bardziej techniczne funkcje
            są rozdzielone na osobne, proste zakładki.
        </p>
    </div>

    <div class="utilities-hero-stats">
        <div>
            <strong>@Model.Overview.Meters.Count</strong>
            <span>liczników</span>
        </div>
        <div>
            <strong>@submittedCount</strong>
            <span>do zatwierdzenia</span>
        </div>
        <div>
            <strong>@Model.Overview.Contracts.Count</strong>
            <span>umów</span>
        </div>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="success-box top-gap">@success</div>
}

@if (TempData["Error"] is string error)
{
    <div class="error-box top-gap">@error</div>
}

<nav class="utilities-tabs" aria-label="Sekcje modułu Media">
    <button type="button" class="is-active" data-utilities-tab="readings">
        Odczyty
        @if (submittedCount > 0)
        {
            <span>@submittedCount</span>
        }
    </button>

    <button type="button" data-utilities-tab="contracts">
        Umowy operatorów
        <span>@Model.Overview.Contracts.Count</span>
    </button>

    <button type="button" data-utilities-tab="billing">
        Faktury i rozliczenia
    </button>

    @if (Model.CanManage)
    {
        <button type="button" data-utilities-tab="advanced">
            Zaawansowane
        </button>
    }
</nav>

<section data-utilities-panel="readings">
    <div class="utilities-section-title">
        <div>
            <span>NAJCZĘŚCIEJ UŻYWANE</span>
            <h2>Wpisz odczyt licznika</h2>
            <p>Wybierz licznik, wpisz stan i zapisz. Pozostałe opcje są schowane.</p>
        </div>
    </div>

    @if (Model.Overview.Meters.Count == 0)
    {
        <div class="utilities-empty">
            <strong>Nie ma jeszcze liczników.</strong>
            <span>Dodaj licznik w module Nieruchomości, a pojawi się tutaj automatycznie.</span>
        </div>
    }
    else
    {
        <div class="utilities-reading-layout">
            <section class="utilities-card utilities-reading-entry">
                <form asp-action="SubmitReading"
                      method="post"
                      enctype="multipart/form-data"
                      data-quick-reading-form>
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="source" value="Manual" />

                    <label class="utilities-field utilities-full">
                        <span>Licznik</span>
                        <select name="meterId" required data-reading-meter>
                            @foreach (var meter in Model.Overview.Meters)
                            {
                                var latest = Model.Overview.Readings
                                    .Where(x =>
                                        x.MeterId == meter.Id
                                        && x.Status == ReadingStatuses.Approved)
                                    .OrderByDescending(x => x.ReadingAtUtc)
                                    .FirstOrDefault();

                                var latestText = latest is null
                                    ? "Brak wcześniejszego odczytu"
                                    : $"{latest.ReadingAtUtc.ToLocalTime():dd.MM.yyyy} · {ReadingValue(latest.Id)}";

                                <option value="@meter.Id"
                                        data-unit="@meter.UnitCode"
                                        data-medium="@meter.Medium"
                                        data-latest="@latestText">
                                    @meter.Name · @MediumLabel(meter.Medium)
                                </option>
                            }
                        </select>

                        <small data-reading-last>—</small>
                    </label>

                    <div class="utilities-reading-main">
                        <label class="utilities-field utilities-value-field">
                            <span>Nowy stan</span>
                            <div class="utilities-value-input">
                                <input name="value"
                                       type="number"
                                       step="0.001"
                                       min="0"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       required
                                       autofocus />
                                <b data-reading-unit>—</b>
                            </div>
                        </label>

                        <label class="utilities-field">
                            <span>Strefa</span>
                            <select name="zoneCode" required>
                                <option value="ALL">Całość / jedna strefa</option>
                                <option value="DAY">Dzień</option>
                                <option value="NIGHT">Noc</option>
                            </select>
                        </label>

                        <label class="utilities-field">
                            <span>Data i godzina</span>
                            <input name="readingAtLocal"
                                   type="datetime-local"
                                   value="@nowLocal"
                                   required />
                        </label>
                    </div>

                    <details class="utilities-more">
                        <summary>Zdjęcie i dodatkowe opcje</summary>

                        <div class="utilities-more-body">
                            <label class="utilities-field utilities-full">
                                <span>Zdjęcie licznika / dokument</span>
                                <input name="photo"
                                       type="file"
                                       accept="image/*,.pdf" />
                                <small>Opcjonalnie. Maksymalnie 25 MB.</small>
                            </label>
                        </div>
                    </details>

                    <button class="btn btn-primary utilities-submit-reading"
                            type="submit">
                        Zapisz odczyt
                    </button>
                </form>
            </section>

            <section class="utilities-card">
                <div class="utilities-card-head">
                    <div>
                        <span>LICZNIKI</span>
                        <h3>Szybki podgląd</h3>
                    </div>
                </div>

                <div class="utilities-meter-list">
                    @foreach (var meter in Model.Overview.Meters)
                    {
                        var latest = Model.Overview.Readings
                            .Where(x =>
                                x.MeterId == meter.Id
                                && x.Status == ReadingStatuses.Approved)
                            .OrderByDescending(x => x.ReadingAtUtc)
                            .FirstOrDefault();

                        <article>
                            <div>
                                <strong>@meter.Name</strong>
                                <small>@MediumLabel(meter.Medium) · @meter.UnitCode</small>
                            </div>

                            <div class="utilities-meter-last">
                                @if (latest is null)
                                {
                                    <span>Brak odczytu</span>
                                }
                                else
                                {
                                    <strong>@ReadingValue(latest.Id)</strong>
                                    <small>@latest.ReadingAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>
    }

    
    <section class="utilities-submeter-tenant" id="submeterTenantSettlement" hidden>
        <div class="utilities-section-title">
            <div>
                <span>ROZLICZENIA LOKATORÓW</span>
                <h2>Podliczniki pokoi</h2>
                <p>
                    e-dom porównuje najnowszy zatwierdzony odczyt z poprzednim,
                    liczy zużycie i może dopisać koszt bezpośrednio do projektu
                    miesięcznego rozliczenia lokatora danego pokoju.
                </p>
            </div>
        </div>

        <div data-submeter-tenant-list></div>
    </section>

<section class="utilities-card utilities-readings-history">
        <div class="utilities-card-head">
            <div>
                <span>HISTORIA</span>
                <h3>Odczyty</h3>
                <p>Ostatnie odczyty są na górze. Korekta nie usuwa wcześniejszego rekordu.</p>
            </div>
        </div>

        @if (Model.Overview.Readings.Count == 0)
        {
            <div class="utilities-empty compact">
                Brak zapisanych odczytów.
            </div>
        }
        else
        {
            <div class="utilities-reading-table">
                @foreach (var reading in Model.Overview.Readings
                    .OrderByDescending(x => x.ReadingAtUtc)
                    .Take(20))
                {
                    var meterName = meterById.TryGetValue(
                        reading.MeterId,
                        out var meter)
                        ? meter.Name
                        : "Licznik";

                    <article class="utilities-reading-row">
                        <div class="utilities-reading-summary">
                            <div>
                                <strong>@meterName</strong>
                                <small>
                                    @reading.ReadingAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    · @reading.Source
                                </small>
                            </div>

                            <div class="utilities-reading-number">
                                <strong>@ReadingValue(reading.Id)</strong>
                                @if (reading.CorrectionOfId.HasValue)
                                {
                                    <small>Korekta wcześniejszego odczytu</small>
                                }
                            </div>

                            <span class="utilities-status utilities-status-@reading.Status.ToLowerInvariant()">
                                @ReadingStatus(reading.Status)
                            </span>
                        </div>

                        @if (Model.CanManage && reading.Status == ReadingStatuses.Submitted)
                        {
                            <div class="utilities-reading-actions">
                                <form asp-action="ApproveReading" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="readingId" value="@reading.Id" />
                                    <input name="reason" placeholder="Komentarz (opcjonalnie)" />
                                    <button class="btn btn-success btn-sm" type="submit">
                                        Zatwierdź
                                    </button>
                                </form>

                                <form asp-action="RejectReading" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="readingId" value="@reading.Id" />
                                    <input name="reason" placeholder="Powód odrzucenia" required />
                                    <button class="btn btn-danger btn-sm" type="submit">
                                        Odrzuć
                                    </button>
                                </form>
                            </div>
                        }

                        @if (Model.CanManage && reading.Status == ReadingStatuses.Approved)
                        {
                            <details class="utilities-inline-details">
                                <summary>Koryguj odczyt</summary>

                                <form asp-action="CorrectReading"
                                      method="post"
                                      class="utilities-edit-grid">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="readingId"
                                           value="@reading.Id" />

                                    <label>
                                        <span>Data</span>
                                        <input name="readingAtLocal"
                                               type="datetime-local"
                                               value="@reading.ReadingAtUtc.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                                               required />
                                    </label>

                                    <label>
                                        <span>Nowa wartość</span>
                                        <input name="value"
                                               type="number"
                                               step="0.001"
                                               min="0"
                                               required />
                                    </label>

                                    <label>
                                        <span>Strefa</span>
                                        <select name="zoneCode">
                                            <option value="ALL">Całość</option>
                                            <option value="DAY">Dzień</option>
                                            <option value="NIGHT">Noc</option>
                                        </select>
                                    </label>

                                    <label>
                                        <span>Powód korekty</span>
                                        <input name="reason" required />
                                    </label>

                                    <label class="utilities-check utilities-full">
                                        <input name="resetOrReplacement"
                                               type="checkbox"
                                               value="true" />
                                        <span>Wymiana / zerowanie licznika — dopuszczam niższą wartość.</span>
                                    </label>

                                    <div class="utilities-full">
                                        <button class="btn btn-secondary btn-sm"
                                                type="submit">
                                            Zapisz korektę
                                        </button>
                                    </div>
                                </form>
                            </details>
                        }
                    </article>
                }
            </div>
        }
    </section>
</section>

<section data-utilities-panel="contracts" hidden>
    <div class="utilities-section-title">
        <div>
            <span>OPERATORZY</span>
            <h2>Umowy na media</h2>
            <p>Podgląd najważniejszych danych, edycja i pełna historia zmian bez kasowania poprzednich wartości.</p>
        </div>

        @if (Model.CanManage)
        {
            <button type="button"
                    class="btn btn-primary"
                    data-contract-create-toggle>
                + Dodaj umowę
            </button>
        }
    </div>

    @if (Model.CanManage)
    {
        <div class="utilities-contract-medium-picker" data-contract-medium-picker>
            <button type="button"
                    class="utilities-medium-choice water"
                    data-contract-medium-choice="Water">
                <span>💧</span>
                <strong>Umowa na wodę</strong>
                <small>
                    @Model.Overview.Contracts.Count(x => x.Medium == "Water") zapisanych
                </small>
                <b>Dodaj / wpisz dane →</b>
            </button>

            <button type="button"
                    class="utilities-medium-choice gas"
                    data-contract-medium-choice="Gas">
                <span>◉</span>
                <strong>Umowa na gaz</strong>
                <small>
                    @Model.Overview.Contracts.Count(x => x.Medium == "Gas") zapisanych
                </small>
                <b>Dodaj / wpisz dane →</b>
            </button>

            <button type="button"
                    class="utilities-medium-choice waste"
                    data-contract-medium-choice="Waste">
                <span>♻</span>
                <strong>Umowa / deklaracja za śmieci</strong>
                <small>
                    @Model.Overview.Contracts.Count(x => x.Medium == "Waste") zapisanych
                </small>
                <b>Dodaj / wpisz dane →</b>
            </button>
        </div>

        <section class="utilities-card utilities-contract-create"
                 data-contract-create-panel
                 hidden>
            <div class="utilities-card-head">
                <div>
                    <span>NOWA UMOWA</span>
                    <h3 data-contract-create-title>Dodaj umowę operatora</h3>
                    <p data-contract-create-subtitle>
                        Wybierz rodzaj medium i uzupełnij dane z umowy lub rachunku.
                    </p>
                </div>

                <button type="button"
                        class="utilities-close"
                        data-contract-create-close
                        aria-label="Zamknij">
                    ×
                </button>
            </div>

            <form asp-action="CreateContract"
                  method="post"
                  class="utilities-edit-grid"
                  data-contract-create-form>
                @Html.AntiForgeryToken()

                <label>
                    <span>Działka</span>
                    <select name="parcelId" required>
                        @foreach (var parcel in Model.Parcels)
                        {
                            <option value="@parcel.Id">@parcel.Name</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Rodzaj medium</span>
                    <select name="medium"
                            data-contract-medium>
                        <option value="Water">Woda</option>
                        <option value="Gas">Gaz</option>
                        <option value="Waste">Odpady / śmieci</option>
                        <option value="Electricity">Prąd</option>
                    </select>
                </label>

                <label>
                    <span data-contract-operator-label>Operator / dostawca</span>
                    <input name="operatorName"
                           data-contract-operator
                           placeholder="np. Aquanet"
                           required />
                </label>

                <label>
                    <span data-contract-number-label>Numer umowy</span>
                    <input name="contractNumber"
                           data-contract-number
                           placeholder="np. 12345678" />
                </label>

                <label>
                    <span data-contract-point-label>Numer klienta / punkt poboru</span>
                    <input name="accountPoint"
                           data-contract-point />
                </label>

                <label data-contract-meter-field>
                    <span>Główny licznik</span>
                    <select name="meterId"
                            data-contract-meter>
                        <option value="">— bez przypisania licznika —</option>
                        @foreach (var meter in Model.Overview.Meters)
                        {
                            <option value="@meter.Id"
                                    data-meter-medium="@meter.Medium">
                                @meter.Name · @MediumLabel(meter.Medium) · @meter.UnitCode
                            </option>
                        }
                    </select>
                    <small data-contract-meter-help>
                        Umowę operatora najlepiej powiązać z licznikiem głównym.
                    </small>
                </label>

                <label>
                    <span>Cykl rozliczeń</span>
                    <select name="billingSchedule">
                        <option value="Monthly">Miesięczny</option>
                        <option value="BiMonthly">Co 2 miesiące</option>
                        <option value="Quarterly">Kwartalny</option>
                        <option value="Annual">Roczny</option>
                    </select>
                </label>

                <label>
                    <span data-contract-fixed-label>Opłata stała / abonament</span>
                    <input name="fixedCharge"
                           type="text"
                           inputmode="decimal"
                           value="0"
                           placeholder="0,00" />
                    <small>Możesz wpisać np. 12,50 albo 12.50.</small>
                </label>

                <label>
                    <span>Umowa obowiązuje od</span>
                    <input name="validFrom"
                           type="date"
                           value="@today.ToString("yyyy-MM-dd")"
                           required />
                </label>

                <label>
                    <span>Umowa obowiązuje do</span>
                    <input name="validTo"
                           type="date" />
                    <small>Puste pole = bezterminowo.</small>
                </label>

                <label>
                    <span>Waluta</span>
                    <input name="currencyCode"
                           value="PLN"
                           maxlength="3" />
                </label>

                <div class="utilities-contract-create-info utilities-full"
                     data-contract-create-info>
                    <strong>Woda</strong>
                    <span>
                        Wpisz operatora, numer umowy / klienta i przypisz główny licznik wody.
                        Po zapisaniu taryfę podstawową ustawisz w „Podgląd / edycja”.
                    </span>
                </div>

                <div class="utilities-full utilities-form-actions">
                    <button type="button"
                            class="btn btn-secondary"
                            data-contract-create-cancel>
                        Anuluj
                    </button>

                    <button class="btn btn-primary"
                            type="submit"
                            data-contract-create-submit>
                        Zapisz umowę na wodę
                    </button>
                </div>
            </form>
        </section>
    }

    @if (Model.Overview.Contracts.Count == 0)
    {
        <div class="utilities-empty">
            <strong>Nie ma jeszcze umów operatorów.</strong>
            <span>Dodaj pierwszą umowę, aby prowadzić taryfy, prognozy i faktury.</span>
        </div>
    }
    else
    {
        <div class="utilities-contract-list">
            @foreach (var contract in Model.Overview.Contracts)
            {
                <article class="utilities-contract-card"
                         data-contract-card="@contract.Id">
                    <div class="utilities-contract-icon">
                        @switch (contract.Medium)
                        {
                            case "Electricity":
                                <text>⚡</text>
                                break;
                            case "Water":
                                <text>💧</text>
                                break;
                            case "Gas":
                                <text>◉</text>
                                break;
                            case "Waste":
                                <text>♻</text>
                                break;
                            default:
                                <text>●</text>
                                break;
                        }
                    </div>

                    <div class="utilities-contract-main">
                        <span>@MediumLabel(contract.Medium)</span>
                        <strong>@contract.OperatorName</strong>
                        <small>
                            @(string.IsNullOrWhiteSpace(contract.ContractNumber)
                                ? "Brak numeru umowy"
                                : $"Umowa: {contract.ContractNumber}")
                        </small>
                    </div>

                    <div class="utilities-contract-state">
                        <span>Umowa operatora</span>
                    </div>

                    <button type="button"
                            class="btn btn-secondary btn-sm"
                            data-contract-open="@contract.Id">
                        Podgląd / edycja
                    </button>
                </article>
            }
        </div>
    }

    <section class="utilities-contract-workspace"
             data-contract-workspace
             hidden>
        <div class="utilities-contract-workspace-head">
            <div>
                <span>SZCZEGÓŁY UMOWY</span>
                <h3 data-contract-workspace-title>Umowa</h3>
                <p data-contract-workspace-subtitle>—</p>
            </div>

            <button type="button"
                    class="utilities-close"
                    data-contract-workspace-close
                    aria-label="Zamknij">
                ×
            </button>
        </div>

        <div data-contract-loading>
            Wczytywanie danych umowy…
        </div>

        <div data-contract-content hidden>
            <div class="utilities-contract-details" data-contract-details></div>

            <form class="utilities-contract-edit"
                  data-contract-edit-form
                  hidden>
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="contractId"
                       data-contract-id />

                <div class="utilities-edit-grid">
                    <label>
                        <span>Operator</span>
                        <input name="operatorName" required />
                    </label>

                    <label>
                        <span>Numer umowy</span>
                        <input name="contractNumber" />
                    </label>

                    <label>
                        <span>Punkt / PPE</span>
                        <input name="accountPoint" />
                    </label>

                    <label>
                        <span>Harmonogram</span>
                        <select name="billingSchedule">
                            <option value="Monthly">Miesięczny</option>
                            <option value="BiMonthly">Co 2 miesiące</option>
                            <option value="Quarterly">Kwartalny</option>
                            <option value="Annual">Roczny</option>
                        </select>
                    </label>

                    <label>
                        <span>Obowiązuje od</span>
                        <input name="validFrom" type="date" required />
                    </label>

                    <label>
                        <span>Obowiązuje do</span>
                        <input name="validTo" type="date" />
                    </label>

                    <label>
                        <span>Opłata stała</span>
                        <input name="fixedCharge"
                               type="number"
                               min="0"
                               step="0.01" />
                    </label>

                    <label>
                        <span>Waluta</span>
                        <input name="currencyCode" maxlength="3" />
                    </label>

                    <label class="utilities-full">
                        <span>Powód / opis zmiany</span>
                        <input name="reason"
                               placeholder="np. nowy numer umowy, zmiana harmonogramu rozliczeń" />
                    </label>
                </div>

                <div class="utilities-form-actions">
                    <button type="button"
                            class="btn btn-secondary"
                            data-contract-edit-cancel>
                        Anuluj
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Zapisz zmiany
                    </button>
                </div>
            </form>

            <section class="utilities-base-tariff">
                <div class="utilities-card-head">
                    <div>
                        <span>TARYFA PODSTAWOWA</span>

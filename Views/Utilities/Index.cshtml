                        <span>Waluta</span>
                        <input name="currencyCode" value="PLN" />
                    </label>

                    <label>
                        <span>Strefa</span>
                        <input name="zoneCode" value="ALL" />
                    </label>

                    <label>
                        <span>Składnik</span>
                        <input name="componentCode" value="Consumption" />
                    </label>

                    <label>
                        <span>Stawka / jednostkę</span>
                        <input name="ratePerUnit"
                               type="number"
                               step="0.000001"
                               min="0"
                               required />

                }

                @foreach (var invoice in Model.Overview.Invoices.Take(10))
                {
                    var contract = contractById.TryGetValue(
                        invoice.UtilityContractId,
                        out var matchingContract)
                        ? matchingContract
                        : null;

                    var comparison = Model.Overview.Comparisons
                        .FirstOrDefault(x => x.UtilityInvoiceId == invoice.Id);

                    <article>
                        <div>
                            <strong>@invoice.InvoiceNo · @Money(invoice.TotalAmountMinor, invoice.CurrencyCode)</strong>
                            <small>
                                @contract?.OperatorName · @MediumLabel(contract?.Medium)
                                · @invoice.PeriodFrom – @invoice.PeriodTo
                            </small>
                        </div>

                        @if (comparison is not null)
                        {
                            <div>
                                <span>Prognoza</span>
                                <strong>@Money(comparison.ForecastAmountMinor, invoice.CurrencyCode)</strong>
                                <small>Różnica: @Money(comparison.DifferenceMinor, invoice.CurrencyCode)</small>
                            </div>
                        }

                        <span class="utilities-status">@invoice.Status</span>
                    </article>
                }

                @foreach (var calculation in Model.Overview.Calculations.Take(6))
                {
                    <article>
                        <div>
                            <strong>Kalkulacja podlicznika · @Money(calculation.CostMinor, calculation.CurrencyCode)</strong>
                            <small>
                                @(meterById.TryGetValue(calculation.MeterId, out var calculationMeter)
                                    ? calculationMeter.Name
                                    : "Licznik")
                                · ilość:
                                @(calculation.QuantityScaled / (decimal)Math.Pow(10, calculation.QuantityScale))
                                @calculation.UnitCode
                            </small>
                        </div>

                        <span class="utilities-status">@calculation.Status</span>
                    </article>
                }
            </div>
        </section>
    }
</section>


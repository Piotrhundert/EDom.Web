@using EDom.Domain.HouseholdFinance
@using EDom.SharedKernel.Values
@model HouseholdFinancePageViewModel
@{
    ViewData["Title"] = "Finanse domowe";
    string Fmt(long minor, string currency = "PLN") => $"{new Money(minor, currency).ToMajor():N2} {currency}";
    var openObligations = Model.Overview.Obligations.Where(x => x.RemainingMinor > 0).ToArray();
    var pendingSubmissions = Model.Overview.PaymentSubmissions.Where(x => x.Status == SubmissionStatuses.Pending).ToArray();
    var openInvoices = Model.Overview.Invoices.Where(x => x.RemainingMinor > 0).ToArray();
    var actionableClaims = Model.Overview.Claims.Where(x => x.Status is ClaimStatuses.Approved or ClaimStatuses.PartiallyApproved).ToArray();
    var pendingClaims = Model.Overview.Claims.Where(x => x.Status == ClaimStatuses.Pending).ToArray();

    var totalOutstandingMinor = openObligations.Sum(x => x.RemainingMinor);
    var totalPendingMinor = pendingSubmissions.Sum(x => x.AmountMinor);
    var totalInvoicesMinor = openInvoices.Sum(x => x.RemainingMinor);
    var totalClaimsMinor = actionableClaims.Sum(x => (x.ApprovedAmountMinor ?? 0) - x.SettledMinor);

    string SubmissionBadge(string? status) => status switch
    {
        var s when s == SubmissionStatuses.Pending => "badge badge-warn",
        var s when s == SubmissionStatuses.Approved => "badge badge-success",
        var s when s == SubmissionStatuses.Rejected => "badge badge-danger",
        _ => "badge badge-muted"
    };

    string ObligationBadge(string? status, long remainingMinor) => remainingMinor switch
    {
        <= 0 => "badge badge-success",
        _ when string.Equals(status, "Overdue", StringComparison.OrdinalIgnoreCase) => "badge badge-danger",
        _ => "badge badge-warn"
    };

    string ClaimBadge(string? status) => status switch
    {
        var s when s == ClaimStatuses.Pending => "badge badge-warn",
        var s when s == ClaimStatuses.Approved => "badge badge-success",
        var s when s == ClaimStatuses.PartiallyApproved => "badge badge-info",
        var s when s == ClaimStatuses.Rejected => "badge badge-danger",
        _ => "badge badge-muted"
    };
}

<section class="hero hero-bank household-finance-hero">
    <div>
        <div class="eyebrow">Moduł wspólnego budżetu</div>
        <h1>Finanse domowe</h1>
        <p>
            Przejrzysty widok rachunku gospodarstwa, obowiązkowych wpłat, zgłoszeń domowników,
            faktur i roszczeń. Domownik widzi własne wpłaty i ich status, a administrator może
            je szybko zatwierdzić lub odrzucić.
        </p>
    </div>
    <div class="status-pill">PKG-015h</div>
</section>

@if (TempData["Error"] is string error)
{
    <div class="error-box">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="info-box">@success</div>
}

<section class="panel hf-shell">
    <div class="hf-topbar">
        <div>
            <h2>Centrum finansów domowych</h2>
            <p class="muted">
                @(Model.CanManage
                    ? "Tu zarządzasz wspólnym rachunkiem, należnościami, zgłoszeniami wpłat i decyzjami administracyjnymi."
                    : "Tu widzisz własne należności wobec domu, swoje zgłoszenia wpłat i ich bieżący status.")
            </p>
        </div>
        <div class="hf-quick-links">
            @if (Model.CanManage)
            {
                <a href="#hf-pending" class="hf-tile-link">
                    <span>Do zatwierdzenia</span>
                    <strong>@pendingSubmissions.Length</strong>
                    <small>zgłoszeń wpłat</small>
                </a>
                <a href="#hf-obligations" class="hf-tile-link">
                    <span>Należności</span>
                    <strong>@openObligations.Length</strong>
                    <small>otwartych pozycji</small>
                </a>
                <a href="#hf-invoices" class="hf-tile-link">
                    <span>Faktury</span>
                    <strong>@openInvoices.Length</strong>
                    <small>do opłacenia</small>
                </a>
                <a href="#hf-claims" class="hf-tile-link">
                    <span>Roszczenia</span>
                    <strong>@pendingClaims.Length</strong>
                    <small>oczekuje na decyzję</small>
                </a>
            }
            else
            {
                <a href="#hf-submit-payment" class="hf-tile-link">
                    <span>Wyślij wpłatę</span>
                    <strong>+</strong>
                    <small>zgłoszenie do domu</small>
                </a>
                <a href="#hf-my-status" class="hf-tile-link">
                    <span>Status wpłat</span>
                    <strong>@Model.Overview.PaymentSubmissions.Count</strong>
                    <small>moich zgłoszeń</small>
                </a>
                <a href="#hf-obligations" class="hf-tile-link">
                    <span>Należności</span>
                    <strong>@openObligations.Length</strong>
                    <small>otwartych pozycji</small>
                </a>
            }
        </div>
    </div>

    <div class="hf-kpi-grid">
        @if (Model.CanManage)
        {
            <article class="hf-kpi-card">
                <span>Saldo bankowe</span>
                <strong>@Fmt(Model.Overview.Ledger.BankBalanceMinor, Model.Overview.Ledger.CurrencyCode)</strong>
                <small>Środki na rachunku domu</small>
            </article>
            <article class="hf-kpi-card">
                <span>Saldo gotówki</span>
                <strong>@Fmt(Model.Overview.Ledger.CashBalanceMinor, Model.Overview.Ledger.CurrencyCode)</strong>
                <small>Środki gotówkowe</small>
            </article>
            <article class="hf-kpi-card">
                <span>Wpłaty do akceptacji</span>
                <strong>@pendingSubmissions.Length</strong>
                <small>@Fmt(totalPendingMinor, Model.Overview.Ledger.CurrencyCode)</small>
            </article>
            <article class="hf-kpi-card">
                <span>Otwarte należności</span>
                <strong>@Fmt(totalOutstandingMinor, Model.Overview.Ledger.CurrencyCode)</strong>
                <small>@openObligations.Length aktywnych pozycji</small>
            </article>
        }
        else
        {
            <article class="hf-kpi-card">
                <span>Pozostało do wpłaty</span>
                <strong>@Fmt(totalOutstandingMinor, "PLN")</strong>
                <small>Twoje aktywne należności wobec domu</small>
            </article>
            <article class="hf-kpi-card">
                <span>Wysłane zgłoszenia</span>
                <strong>@Model.Overview.PaymentSubmissions.Count</strong>
                <small>Ile wpłat zgłoszono do zatwierdzenia</small>
            </article>
            <article class="hf-kpi-card">
                <span>Oczekujące decyzje</span>
                <strong>@pendingSubmissions.Length</strong>
                <small>Zgłoszenia ze statusem „Oczekuje”</small>
            </article>
            <article class="hf-kpi-card">
                <span>Rozliczone wpłaty</span>
                <strong>@Model.Overview.PaymentSubmissions.Count(x => x.Status == SubmissionStatuses.Approved)</strong>
                <small>Zatwierdzone przez administratora</small>
            </article>
        }
    </div>
</section>

@if (Model.CanManage)
{
    <section class="panel hf-section" id="hf-pending">
        <div class="hf-section-head">
            <div>
                <h2>Wpłaty domowników do zatwierdzenia</h2>
                <p class="muted">Najważniejsza sekcja dla administratora. Tutaj widać nowe zgłoszenia i można je od razu zatwierdzić albo odrzucić.</p>
            </div>
            <div class="hf-inline-chip">@pendingSubmissions.Length oczekujących</div>
        </div>

        @if (pendingSubmissions.Length == 0)
        {
            <div class="empty-note">Brak zgłoszeń oczekujących na decyzję.</div>
        }
        else
        {
            <div class="hf-status-table-wrap hf-pending-table-wrap">
                <table class="hf-status-table hf-pending-table">
                    <thead>
                        <tr>
                            <th>Domownik</th>
                            <th>Okres</th>
                            <th>Kwota</th>
                            <th>Forma</th>
                            <th>Status</th>
                            <th>Decyzja</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in pendingSubmissions)
                    {
                        <tr>
                            <td>
                                <strong>@s.PersonName</strong>
                                <small class="muted">Zgłoszenie do wspólnego rachunku</small>
                            </td>
                            <td>@s.PeriodKey</td>
                            <td><strong>@Fmt(s.AmountMinor, s.CurrencyCode)</strong></td>
                            <td>@s.PaymentMethod</td>
                            <td><span class="@SubmissionBadge(s.Status)">@s.Status</span></td>
                            <td class="hf-pending-action-cell">
                                <details class="hf-row-decision">
                                    <summary>Rozpatrz wpłatę</summary>
                                    <div class="hf-row-decision-body">
                                        <form asp-controller="HouseholdContributionPayments" asp-action="Approve" method="post" class="hf-inline-decision-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@s.Id" />
                                            <input type="hidden" name="approvedAmount" value="@((s.AmountMinor / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" />
                                            <label>
                                                Uwagi do zatwierdzenia
                                                <input name="decisionReason" maxlength="500" placeholder="np. przelew zgodny" />
                                            </label>
                                            <button class="btn btn-success" type="submit">Zatwierdź i zaksięguj</button>
                                        </form>

                                        <form asp-controller="HouseholdContributionPayments" asp-action="Reject" method="post" class="hf-inline-decision-form hf-inline-reject-form" data-confirm="Odrzucić to zgłoszenie wpłaty? Saldo domu nie zostanie zmienione.">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="submissionId" value="@s.Id" />
                                            <label>
                                                Powód odrzucenia
                                                <input name="reason" maxlength="500" required placeholder="np. błędna kwota lub brak potwierdzenia" />
                                            </label>
                                            <button class="btn btn-danger" type="submit">Odrzuć zgłoszenie</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="muted hf-pending-help">Zatwierdzenie księguje wpływ na rachunku domu i tworzy odpowiadające mu obciążenie prywatnego konta domownika. Odrzucenie nie zmienia żadnego salda.</p>
        }
    </section>
}

<section class="panel hf-section" id="hf-submit-payment">
    <div class="hf-section-head">
        <div>
            <h2>@(Model.CanManage ? "Dodaj lub zgłoś wpłatę" : "Wyślij wpłatę do domu")</h2>
            <p class="muted">
                @(Model.CanManage
                    ? "Administrator może też ręcznie zgłosić wpłatę, ale saldo domu zmieni się dopiero po zatwierdzeniu zgłoszenia."
                    : "Po wysłaniu zgłoszenia administrator zobaczy Twoją wpłatę i będzie mógł ją zatwierdzić. Do tego czasu status pozostaje oczekujący.")
            </p>
        </div>
        <div class="hf-inline-chip">Zgłoszenie bez księgowania salda</div>
    </div>

    <div class="hf-form-card">
        <form asp-action="SubmitPayment" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            <label>Okres<input name="PeriodKey" value="@DateTime.Today.ToString("yyyy-MM")" /></label>
            <label>Kwota<input name="Amount" type="number" step="0.01" min="0.01" required /></label>
            <label>Waluta<input name="CurrencyCode" value="PLN" maxlength="3" /></label>
            <label>Forma
                <select name="PaymentMethod">
                    <option value="Bank">Przelew</option>
                    <option value="Cash">Gotówka</option>
                </select>
            </label>
            <label>Data wysłania<input name="PaidAtUtc" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" /></label>
            <label>Identyfikator potwierdzenia<input name="ProofFingerprint" maxlength="128" placeholder="np. końcówka przelewu" /></label>
            <button class="btn" type="submit">Wyślij zgłoszenie wpłaty</button>
        </form>
    </div>
</section>

<section class="panel hf-section" id="hf-my-status">
    <div class="hf-section-head">
        <div>
            <h2>@(Model.CanManage ? "Rejestr wszystkich zgłoszeń wpłat" : "Moje wysłane wpłaty i status")</h2>
            <p class="muted">
                @(Model.CanManage
                    ? "Pełna lista zgłoszeń od wszystkich domowników z czytelnym statusem i wynikiem decyzji."
                    : "Tutaj sprawdzisz, czy Twoja wpłata czeka na decyzję, została zatwierdzona czy odrzucona.")
            </p>
        </div>
        <div class="hf-inline-chip">@Model.Overview.PaymentSubmissions.Count zgłoszeń</div>
    </div>

    @if (Model.Overview.PaymentSubmissions.Count == 0)
    {
        <div class="empty-note">Brak zgłoszonych wpłat.</div>
    }
    else
    {
        <div class="hf-status-table-wrap">
            <table class="hf-status-table">
                <thead>
                    <tr>
                        <th>Osoba</th>
                        <th>Okres</th>
                        <th>Kwota</th>
                        <th>Forma</th>
                        <th>Status</th>
                        <th>Uwagi / decyzja</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Overview.PaymentSubmissions)
                {
                    <tr>
                        <td>@s.PersonName</td>
                        <td>@s.PeriodKey</td>
                        <td>@Fmt(s.AmountMinor, s.CurrencyCode)</td>
                        <td>@s.PaymentMethod</td>
                        <td><span class="@SubmissionBadge(s.Status)">@s.Status</span></td>
                        <td>@(string.IsNullOrWhiteSpace(s.DecisionReason) ? "—" : s.DecisionReason)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel hf-section" id="hf-obligations">
    <div class="hf-section-head">
        <div>
            <h2>@(Model.CanManage ? "Należności i obowiązkowe wpłaty" : "Twoje należności wobec domu")</h2>
            <p class="muted">Zestawienie aktualnych zobowiązań z widoczną kwotą wpłaconą, pozostałą do spłaty i terminem.</p>
        </div>
        <div class="hf-inline-chip">@Fmt(totalOutstandingMinor, "PLN") do rozliczenia</div>
    </div>

    @if (Model.Overview.Obligations.Count == 0)
    {
        <div class="empty-note">Brak należności.</div>
    }
    else
    {
        <div class="hf-obligation-grid">
            @foreach (var x in Model.Overview.Obligations)
            {
                <article class="hf-obligation-card">
                    <div class="hf-obligation-head">
                        <div>
                            <h3>@x.PersonName</h3>
                            <p>@x.PeriodKey</p>
                        </div>
                        <span class="@ObligationBadge(x.Status, x.RemainingMinor)">@x.Status</span>
                    </div>

                    <div class="hf-obligation-body">
                        <div><span>Pierwotnie</span><strong>@Fmt(x.OriginalAmountMinor, x.CurrencyCode)</strong></div>
                        <div><span>Korekty</span><strong>@Fmt(x.AdjustmentsMinor, x.CurrencyCode)</strong></div>
                        <div><span>Wpłacono</span><strong>@Fmt(x.PaidMinor, x.CurrencyCode)</strong></div>
                        <div><span>Pozostało</span><strong>@Fmt(x.RemainingMinor, x.CurrencyCode)</strong></div>
                        <div><span>Termin</span><strong>@x.DueDate</strong></div>
                    </div>
                </article>
            }
        </div>
    }

    @if (Model.CanManage)
    {
        <div class="hf-management-split">
            <details class="hf-details-card" id="hf-rules">
                <summary>Dodaj regułę wpłaty</summary>
                <form asp-action="Rule" method="post" class="form-grid">
                    @Html.AntiForgeryToken()
                    <label>Osoba<select name="PersonId">@foreach (var p in Model.People){<option value="@p.Id">@p.Name</option>}</select></label>
                    <label>Metoda<select name="Method"><option value="Fixed">Stała kwota</option><option value="Percent">Procent wynagrodzenia</option><option value="FixedPlusPercent">Kwota + procent</option></select></label>
                    <label>Kwota stała<input name="FixedAmount" type="number" step="0.01" min="0" /></label>
                    <label>Procent<input name="Percent" type="number" step="0.01" min="0" max="100" /></label>
                    <label>Termin<select name="DuePolicyType"><option value="FixedDay">Stały dzień miesiąca</option><option value="IncomeOffset">Dni od faktycznej wypłaty</option></select></label>
                    <label>Dzień / liczba dni<input name="DueDayOrOffset" type="number" value="10" min="0" max="365" /></label>
                    <label>Od<input name="ValidFrom" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></label>
                    <label>Do<input name="ValidTo" type="date" /></label>
                    <button class="btn" type="submit">Dodaj regułę</button>
                </form>
            </details>

            @if (Model.Overview.Rules.Count > 0)
            {
                <details class="hf-details-card">
                    <summary>Utwórz należność ręcznie / planowaną</summary>
                    <form asp-action="Obligation" method="post" class="form-grid">
                        @Html.AntiForgeryToken()
                        <label>Reguła<select name="ContributionRuleId">@foreach (var r in Model.Overview.Rules){<option value="@r.Id">@r.PersonName — @r.Method</option>}</select></label>
                        <label>Osoba<select name="PersonId">@foreach (var p in Model.People){<option value="@p.Id">@p.Name</option>}</select></label>
                        <label>Okres<input name="PeriodKey" value="@DateTime.Today.ToString("yyyy-MM")" pattern="[0-9]{4}-[0-9]{2}" /></label>
                        <label>Podstawa dochodu<input name="IncomeAmount" type="number" step="0.01" min="0" /></label>
                        <label>Data dochodu<input name="IncomeDate" type="date" /></label>
                        <label><input name="IsDraft" type="checkbox" value="true" checked /> Robocza</label>
                        <button class="btn" type="submit">Utwórz należność</button>
                    </form>
                </details>
            }
        </div>
    }
</section>

<section class="panel hf-section" id="hf-invoices">
    <div class="hf-section-head">
        <div>
            <h2>Faktury gospodarstwa</h2>
            <p class="muted">Lista wspólnych rachunków domu z kwotą pozostałą do zapłaty i szybkim przejściem do księgowania płatności.</p>
        </div>
        <div class="hf-inline-chip">@Fmt(totalInvoicesMinor, "PLN") do zapłaty</div>
    </div>

    @if (Model.Overview.Invoices.Count > 0)
    {
        <div class="hf-status-table-wrap">
            <table class="hf-status-table">
                <thead><tr><th>Numer</th><th>Dostawca</th><th>Kategoria</th><th>Brutto</th><th>Zapłacono</th><th>Pozostało</th><th>Termin</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var i in Model.Overview.Invoices)
                {
                    <tr>
                        <td>@i.InvoiceNo</td>
                        <td>@i.Supplier</td>
                        <td>@i.CategoryCode</td>
                        <td>@Fmt(i.GrossMinor, i.CurrencyCode)</td>
                        <td>@Fmt(i.PaidMinor, i.CurrencyCode)</td>
                        <td>@Fmt(i.RemainingMinor, i.CurrencyCode)</td>
                        <td>@i.DueDate</td>
                        <td>@i.Status</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-note">Brak faktur gospodarstwa.</div>
    }

    @if (Model.CanManage)
    {
        <div class="hf-management-split">
            <details class="hf-details-card">
                <summary>Dodaj fakturę</summary>
                <form asp-action="Invoice" method="post" class="form-grid">
                    @Html.AntiForgeryToken()
                    <label>Numer<input name="InvoiceNo" required /></label>
                    <label>Dostawca<input name="Supplier" required /></label>
                    <label>Kategoria<input name="CategoryCode" value="Other" /></label>
                    <label>Od<input name="PeriodFrom" type="date" /></label>
                    <label>Do<input name="PeriodTo" type="date" /></label>
                    <label>Wystawiono<input name="IssuedOn" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></label>
                    <label>Termin<input name="DueDate" type="date" value="@DateOnly.FromDateTime(DateTime.Today.AddDays(14)).ToString("yyyy-MM-dd")" /></label>
                    <label>Netto<input name="Net" type="number" step="0.01" min="0" /></label>
                    <label>VAT<input name="Vat" type="number" step="0.01" min="0" /></label>
                    <label>Brutto<input name="Gross" type="number" step="0.01" min="0.01" required /></label>
                    <label>Waluta<input name="CurrencyCode" value="PLN" maxlength="3" /></label>
                    <button class="btn" type="submit">Dodaj fakturę</button>
                </form>
            </details>

            @if (openInvoices.Length > 0)
            {
                <details class="hf-details-card">
                    <summary>Zarejestruj płatność faktury</summary>
                    <form asp-action="PayInvoice" method="post" class="form-grid">
                        @Html.AntiForgeryToken()
                        <label>Faktura<select name="InvoiceId">@foreach (var i in openInvoices){<option value="@i.Id">@i.InvoiceNo — @Fmt(i.RemainingMinor, i.CurrencyCode)</option>}</select></label>
                        <label>Kwota<input name="Amount" type="number" step="0.01" min="0.01" required /></label>
                        <label>Źródło<select name="SourceType"><option value="HouseholdBank">Rachunek domowy — bank</option><option value="HouseholdCash">Rachunek domowy — gotówka</option></select></label>
                        <label>Data<input name="PaidAtUtc" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" /></label>
                        <button class="btn" type="submit">Zaksięguj płatność</button>
                    </form>
                </details>
            }
        </div>
    }
</section>

<section class="panel hf-section" id="hf-claims">
    <div class="hf-section-head">
        <div>
            <h2>Rachunki opłacone prywatnie</h2>
            <p class="muted">Zgłoszenia prywatnych wydatków na potrzeby domu wraz z decyzją o zwrocie albo kompensacie.</p>
        </div>
        <div class="hf-inline-chip">@Fmt(totalClaimsMinor, "PLN") do dalszego rozliczenia</div>
    </div>

    <details class="hf-details-card" open>
        <summary>Zgłoś koszt gospodarstwa opłacony ze swoich środków</summary>
        <form asp-action="Claim" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            <label>Faktura<select name="HouseholdInvoiceId"><option value="">Bez istniejącej faktury</option>@foreach (var i in Model.Overview.Invoices){<option value="@i.Id">@i.InvoiceNo — @i.Supplier</option>}</select></label>
            <label>Kwota<input name="ClaimedAmount" type="number" step="0.01" min="0.01" required /></label>
            <label>Waluta<input name="CurrencyCode" value="PLN" /></label>
            <label>Data<input name="PaidAtUtc" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" /></label>
            <label>Propozycja<select name="ProposedSettlementType"><option value="Refund">Zwrot</option><option value="Compensation">Kompensata wpłaty</option></select></label>
            <label>Opis<input name="Description" /></label>
            <button class="btn" type="submit">Zgłoś koszt</button>
        </form>
    </details>

    @if (Model.Overview.Claims.Count > 0)
    {
        <div class="hf-obligation-grid hf-claims-grid">
            @foreach (var c in Model.Overview.Claims)
            {
                <article class="hf-obligation-card hf-claim-card">
                    <div class="hf-obligation-head">
                        <div>
                            <h3>@c.PersonName</h3>
                            <p>Rozliczenie wydatku prywatnego</p>
                        </div>
                        <span class="@ClaimBadge(c.Status)">@c.Status</span>
                    </div>
                    <div class="hf-obligation-body">
                        <div><span>Zgłoszono</span><strong>@Fmt(c.ClaimedAmountMinor, c.CurrencyCode)</strong></div>
                        <div><span>Zatwierdzono</span><strong>@(c.ApprovedAmountMinor.HasValue ? Fmt(c.ApprovedAmountMinor.Value, c.CurrencyCode) : "—")</strong></div>
                        <div><span>Rozliczono</span><strong>@Fmt(c.SettledMinor, c.CurrencyCode)</strong></div>
                        <div><span>Powód / uwagi</span><strong>@(string.IsNullOrWhiteSpace(c.Reason) ? "—" : c.Reason)</strong></div>
                    </div>
                </article>
            }
        </div>
    }

    @if (Model.CanManage)
    {
        <div class="hf-management-split">
            @if (pendingClaims.Length > 0)
            {
                <details class="hf-details-card">
                    <summary>Zatwierdź / odrzuć roszczenie</summary>
                    <form asp-action="DecideClaim" method="post" class="form-grid">
                        @Html.AntiForgeryToken()
                        <label>Roszczenie<select name="ClaimId">@foreach(var c in pendingClaims){<option value="@c.Id">@c.PersonName — @Fmt(c.ClaimedAmountMinor,c.CurrencyCode)</option>}</select></label>
                        <label>Kwota zatwierdzona<input name="ApprovedAmount" type="number" step="0.01" min="0" /></label>
                        <label>Powód<input name="Reason" required /></label>
                        <label><input name="Approve" type="checkbox" value="true" checked /> Zatwierdź</label>
                        <button class="btn" type="submit">Zapisz decyzję</button>
                    </form>
                </details>
            }

            @if (actionableClaims.Length > 0)
            {
                <details class="hf-details-card">
                    <summary>Rozlicz zatwierdzone roszczenie</summary>
                    <form asp-action="SettleClaim" method="post" class="form-grid">
                        @Html.AntiForgeryToken()
                        <label>Roszczenie<select name="ClaimId">@foreach(var c in actionableClaims){<option value="@c.Id">@c.PersonName — pozostało @Fmt((c.ApprovedAmountMinor ?? 0)-c.SettledMinor,c.CurrencyCode)</option>}</select></label>
                        <label>Sposób<select name="SettlementType"><option value="Refund">Zwrot pieniędzy</option><option value="Compensation">Kompensata należności</option></select></label>
                        <label>Kwota<input name="Amount" type="number" step="0.01" min="0.01" required /></label>
                        <label>Należność do kompensaty<select name="TargetObligationId"><option value="">—</option>@foreach(var o in openObligations){<option value="@o.Id">@o.PersonName — @o.PeriodKey — @Fmt(o.RemainingMinor,o.CurrencyCode)</option>}</select></label>
                        <label>Kieszeń zwrotu<select name="Pocket"><option value="Bank">Bank</option><option value="Cash">Gotówka</option></select></label>
                        <button class="btn" type="submit">Rozlicz roszczenie</button>
                    </form>
                </details>
            }
        </div>
    }
</section>

@if (Model.CanManage && openObligations.Length > 0)
{
    <section class="panel hf-section">
        <div class="hf-section-head">
            <div>
                <h2>Korekty i jednorazowe zwolnienia</h2>
                <p class="muted">Korekta nie nadpisuje pierwotnej należności. Możesz nią zwiększyć, zmniejszyć albo wyzerować obowiązek — zawsze z podaniem przyczyny.</p>
            </div>
        </div>
        <div class="hf-form-card">
            <form asp-action="AdjustObligation" method="post" class="form-grid">
                @Html.AntiForgeryToken()
                <label>Należność<select name="ObligationId">@foreach(var o in openObligations){<option value="@o.Id">@o.PersonName — @o.PeriodKey — pozostało @Fmt(o.RemainingMinor,o.CurrencyCode)</option>}</select></label>
                <label>Korekta<input name="AdjustmentAmount" type="number" step="0.01" required /></label>
                <label>Powód<input name="Reason" required /></label>
                <button class="btn" type="submit">Dodaj korektę</button>
            </form>
        </div>
    </section>
}

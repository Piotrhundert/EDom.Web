@{
    ViewData["Title"] = "Pulpit";
    var modules = ViewData["Modules"] as IReadOnlyList<ModuleDefinition> ?? Array.Empty<ModuleDefinition>();
    var householdName = ViewData["HouseholdName"] as string ?? "Twoje gospodarstwo";
}
<section class="hero hero-dashboard">
    <div>
        <div class="eyebrow">@householdName</div>
        <h1>Dzień dobry, @ViewData["DisplayName"]</h1>
        <p>Wybierz obszar, w którym chcesz pracować. Najważniejsze moduły i akcje są teraz uporządkowane w jednym, spójnym układzie.</p>
    </div>
    <div class="hero-side">
        <span class="status-pill">MVP · PKG-015</span>
        <div class="hero-note">Widoczność modułów i operacji nadal wynika z aktualnej roli, profilu i zakresu RBAC.</div>
    </div>
</section>

<section class="stats-grid top-gap">
    <article class="stat-card">
        <strong>@modules.Count</strong>
        <span>Dostępne moduły</span>
        <small>Lista jest automatycznie ograniczona do Twoich uprawnień.</small>
    </article>
    <article class="stat-card">
        <strong>12</strong>
        <span>Wersja schematu</span>
        <small>Aktualny schemat danych po zakończeniu pierwszego etapu MVP.</small>
    </article>
    <article class="stat-card">
        <strong>G6</strong>
        <span>Etap MVP</span>
        <small>Warstwa bazowa jest gotowa do testów użytkowych i poprawek UI/UX.</small>
    </article>
</section>

<section class="panel top-gap">
    <div class="section-header">
        <div>
            <div class="eyebrow">Nawigacja główna</div>
            <h2>Obszary e-dom</h2>
            <p class="lead">Każdy kafelek prowadzi bezpośrednio do właściwego modułu. Te same obszary znajdziesz w lewym pasku.</p>
        </div>
    </div>

    <div class="module-grid">
        @foreach (var module in modules)
        {
            <a class="module-card" asp-controller="Modules" asp-action="Index" asp-route-key="@module.Key">
                <span class="module-card-icon" aria-hidden="true">@module.Label.Substring(0, 1).ToUpperInvariant()</span>
                <span class="module-title">@module.Label</span>
                <span class="module-description">@module.Description</span>
                <span class="module-link">Otwórz moduł</span>
            </a>
        }
    </div>
</section>

@model EDom.Application.Rental.LeaseClosingOverview
@using EDom.Domain.Rental
@{
    ViewData["Title"] = "Zamknięcie najmu";
    var today = DateOnly.FromDateTime(DateTime.Today);
    string Money(long minor, string currency) => $"{minor / 100m:0.00} {currency}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Zamknięcie najmu</h1>
        <div class="text-muted">Odbiór pokoju, końcowe saldo, kaucja i archiwizacja bez usuwania historii.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Rental" asp-action="Index">Wróć do umów</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

@if (Model.Closings.Count == 0)
{
    <div class="alert alert-info">Brak rozpoczętych procesów zamknięcia. Rozpocznij zamknięcie z ekranu <strong>Najem</strong>.</div>
}

@foreach (var c in Model.Closings)
{
    var ready = c.Status == LeaseClosingStatuses.ReadyToClose;
    var closed = c.Status == LeaseClosingStatuses.Closed;
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><strong>@c.TenantName</strong> · @c.RoomName</div>
            <span class="badge @(closed ? "bg-success" : ready ? "bg-primary" : "bg-warning text-dark")">@c.Status</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-3"><div class="text-muted small">Planowana wyprowadzka</div><strong>@(c.PlannedMoveOutOn?.ToString("yyyy-MM-dd") ?? "—")</strong></div>
                <div class="col-md-3"><div class="text-muted small">Faktyczna wyprowadzka</div><strong>@c.ActualMoveOutOn.ToString("yyyy-MM-dd")</strong></div>
                <div class="col-md-3"><div class="text-muted small">Saldo lokatora</div><strong>@Money(c.FinalTenantBalanceMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Opłaty za opóźnienie</div><strong>@Money(c.LateFeesOutstandingMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Nierozliczone należności</div><strong>@Money(c.SettlementOutstandingMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Dostępne nadpłaty</div><strong>@Money(c.AvailableCreditsMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Kaucja wpłacona</div><strong>@Money(c.DepositPaidMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Kaucja do rozliczenia</div><strong>@Money(c.DepositRefundDueMinor, c.CurrencyCode)</strong></div>
                <div class="col-md-3"><div class="text-muted small">Końcowe odczyty liczników</div><strong>@c.FinalRoomMeterReadingCount / @c.ActiveRoomMeterCount</strong> @if (c.FinalMeterReadingsComplete) { <span class="badge bg-success ms-1">OK</span> } else { <span class="badge bg-danger ms-1">Brak</span> }</div>
            </div>

            <div class="border rounded p-3 mb-3">
                <h2 class="h6">1. Odbiór pokoju</h2>
                @if (c.HasReturnProtocol)
                {
                    <span class="badge bg-success">Protokół odbioru wykonany</span>
                    @if (c.ReturnProtocolDocumentId.HasValue)
                    {
                        <a class="btn btn-sm btn-outline-primary ms-2" asp-action="Document" asp-route-documentId="@c.ReturnProtocolDocumentId">PDF protokołu</a>
                    }
                }
                else if (c.ReturnProtocolSkipped)
                {
                    <div class="alert alert-warning mb-2">Protokół pominięto: @c.ReturnProtocolSkipReason</div>
                }
                else if (!closed)
                {
                    <form asp-action="ReturnProtocol" method="post" class="row g-2 mb-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="closingId" value="@c.ClosingId" />
                        <input type="hidden" name="contractId" value="@c.ContractId" />
                        <div class="col-md-3"><input name="protocolDate" type="date" value="@today.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                        <div class="col-md-6"><input name="notes" class="form-control" placeholder="Stan pokoju, wyposażenie, klucze, liczniki…" /></div>
                        <div class="col-md-3"><button class="btn btn-primary w-100">Utwórz protokół odbioru</button></div>
                    </form>
                    <form asp-action="SkipReturnProtocol" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="closingId" value="@c.ClosingId" />
                        <div class="col-md-9"><input name="reason" class="form-control" placeholder="Powód świadomego pominięcia protokołu" required /></div>
                        <div class="col-md-3"><button class="btn btn-outline-warning w-100">Pomiń z uzasadnieniem</button></div>
                    </form>
                }
            </div>

            <div class="border rounded p-3 mb-3">
                <h2 class="h6">2. Rozliczenie kaucji</h2>
                <div class="small text-muted mb-2">Potrącono: @Money(c.DepositDeductedMinor, c.CurrencyCode) · Zwrócono: @Money(c.DepositRefundedMinor, c.CurrencyCode)</div>
                @if (!closed && c.DepositRefundDueMinor > 0)
                {
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <form asp-action="DeductDeposit" method="post" class="row g-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="closingId" value="@c.ClosingId" />
                                <div class="col-4"><input name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Kwota" required /></div>
                                <div class="col-8"><select name="category" class="form-select"><option value="Damage">Szkoda</option><option value="MissingEquipment">Brak wyposażenia</option><option value="MissingKeys">Brak kluczy</option><option value="Cleaning">Sprzątanie</option><option value="Other">Inne</option></select></div>
                                <div class="col-12"><input name="reason" class="form-control" placeholder="Uzasadnienie potrącenia" required /></div>
                                <div class="col-12"><button class="btn btn-outline-danger">Zapisz potrącenie</button></div>
                            </form>
                        </div>
                        <div class="col-lg-6">
                            <form asp-action="RefundDeposit" method="post" class="row g-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="closingId" value="@c.ClosingId" />
                                <div class="col-4"><input name="amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Kwota" required /></div>
                                <div class="col-4"><select name="paymentMethod" class="form-select"><option value="Bank">Przelew</option><option value="Cash">Gotówka</option></select></div>
                                <div class="col-4"><button class="btn btn-outline-success w-100">Zapisz zwrot</button></div>
                                <div class="col-12"><input name="reason" class="form-control" value="Zwrot kaucji po zakończeniu najmu" required /></div>
                            </form>
                        </div>
                    </div>
                }
                @if (c.DepositTransactions.Count > 0)
                {
                    <div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Typ</th><th>Kwota</th><th>Kategoria / forma</th><th>Opis</th></tr></thead><tbody>
                    @foreach (var t in c.DepositTransactions)
                    {
                        <tr><td>@t.TransactionType</td><td>@Money(t.AmountMinor, t.CurrencyCode)</td><td>@(t.Category ?? t.PaymentMethod ?? "—")</td><td>@t.Reason</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>

            @if (!closed)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <form asp-action="Refresh" method="post">@Html.AntiForgeryToken()<input type="hidden" name="closingId" value="@c.ClosingId" /><button class="btn btn-outline-secondary">Przelicz saldo końcowe</button></form>
                    <form asp-action="Finalize" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="closingId" value="@c.ClosingId" /><select name="accountDisposition" class="form-select"><option value="KeepInactiveScope">Zachowaj konto bez aktywnego zakresu lokatora</option><option value="DeactivateAccount">Dezaktywuj konto byłego lokatora</option></select><button class="btn btn-success" disabled="@(!ready)">Rozlicz i zamknij najem</button></form>
                </div>
                @if (!ready)
                {
                    <div class="text-muted small mt-2">Przycisk zamknięcia odblokuje się po odbiorze pokoju, zatwierdzeniu końcowych odczytów liczników oraz rozliczeniu wszystkich należności, opłat za opóźnienie, nadpłat i kaucji.</div>
                }
            }
        </div>
    </div>
}

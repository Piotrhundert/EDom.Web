@model EDom.Application.Property.PropertyOverview
@using EDom.Domain.Property
@{
    ViewData["Title"] = "Nieruchomości";
    var canCreateParcel = ViewData["CanCreateParcel"] as bool? == true;
    var canAssets = ViewData["CanAssets"] as bool? == true;
    var canMeters = ViewData["CanMeters"] as bool? == true;
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;

    var parcelCount = Model.Parcels.Count;
    var buildingCount = Model.Buildings.Count;
    var roomCount = Model.Rooms.Count;
    var assetCount = Model.Assets.Count;
    var meterCount = Model.Meters.Count;
    var rentableCount = Model.Rooms.Count(x => x.IsRentable);
    var commonCount = Model.Rooms.Count(x => x.IsCommonArea);
}
<link rel="stylesheet" href="~/css/property-ui.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/property-details-ui.css" asp-append-version="true" />

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="success-box property-message">@success</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger property-message">@error</div>
}

<form id="property-details-token" hidden>
    @Html.AntiForgeryToken()
</form>

<div class="property-page">
    <section class="property-hero">
        <div class="property-hero-head">
            <div>
                <div class="property-eyebrow">Nieruchomości · Property &amp; Equipment</div>
                <h1>Nieruchomości i wyposażenie</h1>
                <p>Jedno miejsce do zarządzania działkami, budynkami, pomieszczeniami, wyposażeniem oraz licznikami.</p>
            </div>
            <span class="property-schema-badge">Schema 8</span>
        </div>

        <div class="property-summary">
            <article>
                <span>Działki</span>
                <strong>@parcelCount</strong>
                <small>główne lokalizacje</small>
            </article>
            <article>
                <span>Budynki</span>
                <strong>@buildingCount</strong>
                <small>w całym gospodarstwie</small>
            </article>
            <article>
                <span>Pomieszczenia</span>
                <strong>@roomCount</strong>
                <small>@rentableCount do wynajmu · @commonCount wspólnych</small>
            </article>
            <article>
                <span>Wyposażenie</span>
                <strong>@assetCount</strong>
                <small>zarejestrowanych elementów</small>
            </article>
            <article>
                <span>Liczniki</span>
                <strong>@meterCount</strong>
                <small>główne i podliczniki</small>
            </article>
        </div>

        <nav class="property-section-nav" aria-label="Sekcje nieruchomości">
            <a href="#property-structure">Struktura</a>
            @if (canAssets)
            {
                <a href="#property-assets">Wyposażenie</a>
            }
            @if (canMeters)
            {
                <a href="#property-meters">Liczniki</a>
            }
            <a href="#property-manage">Edycja i archiwizacja</a>
        </nav>
    </section>

    <section class="property-section" id="property-structure">
        <div class="property-section-head">
            <div>
                <div class="property-section-kicker">Hierarchia nieruchomości</div>
                <h2>Struktura</h2>
                <p>Działki są poziomem głównym. W każdej działce widzisz przypisane budynki, a następnie ich pomieszczenia.</p>
            </div>
            <span class="property-count-badge">@parcelCount działek · @buildingCount budynków · @roomCount pomieszczeń</span>
        </div>

        @if (Model.Parcels.Count == 0)
        {
            <div class="property-empty-state">
                <strong>Brak działek w dostępnym zakresie</strong>
                <p>Dodaj pierwszą działkę, aby rozpocząć budowanie struktury nieruchomości.</p>
            </div>
        }
        else
        {
            <div class="property-tree">
                @foreach (var parcel in Model.Parcels)
                {
                    var parcelBuildings = Model.Buildings.Where(x => x.ParcelId == parcel.Id).ToList();
                    var parcelRooms = Model.Rooms.Count(x => parcelBuildings.Any(b => b.Id == x.BuildingId));
                    var parcelMeters = Model.Meters
                        .Where(x => x.LocationType == "Parcel" && x.LocationId == parcel.Id)
                        .ToList();

                    <article class="property-parcel-card" data-property-details-type="Parcel" data-property-id="@parcel.Id">
                        <div class="property-parcel-head">
                            <div class="property-object-icon property-object-icon-parcel">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8l8-5 8 5v12M8 20v-7h8v7M2 20h20" /></svg>
                            </div>
                            <div class="property-object-title">
                                <span class="property-object-type">Działka</span>
                                <h3>@parcel.Name</h3>
                                <p>@(parcel.AddressText ?? "Brak adresu / lokalizacji")</p>
                            </div>
                            <div class="property-object-meta">
                                <span class="property-status-pill">@parcel.Status</span>
                                <small>@parcelBuildings.Count bud. · @parcelRooms pom.</small>
                                <button type="button"
                                        class="property-details-edit-button"
                                        data-property-details-edit="Parcel"
                                        data-property-details-id="@parcel.Id">
                                    Edytuj dane
                                </button>
                            </div>
                        </div>

                        <div class="property-details-summary"
                             data-property-details-summary="Parcel"
                             data-property-details-id="@parcel.Id"></div>
                        <div class="property-details-editor"
                             data-property-details-editor="Parcel"
                             data-property-details-id="@parcel.Id"
                             hidden></div>

                        @if (parcelMeters.Count > 0)
                        {
                            <div class="property-attached-meters">
                                @foreach (var meter in parcelMeters)
                                {
                                    <span class="property-attached-meter">
                                        <b>@meter.Name</b>
                                        <small>@(meter.MeterType == MeterTypes.Sub ? (string.Equals(meter.LocationType, "Room", StringComparison.OrdinalIgnoreCase) ? "Podlicznik · rozliczenia lokatorów" : "Podlicznik techniczny") : "Licznik główny") · @meter.Medium · @meter.UnitCode</small>
                                    </span>
                                }
                            </div>
                        }

                        @if (parcelBuildings.Count == 0)
                        {
                            <div class="property-no-children">Ta działka nie ma jeszcze żadnego budynku.</div>
                        }
                        else
                        {
                            <div class="property-buildings">
                                @foreach (var building in parcelBuildings)
                                {
                                    var buildingRooms = Model.Rooms.Where(x => x.BuildingId == building.Id).ToList();
                                    var buildingMeters = Model.Meters
                                        .Where(x => x.LocationType == "Building" && x.LocationId == building.Id)
                                        .ToList();

                                    <section class="property-building-card" data-property-details-type="Building" data-property-id="@building.Id">
                                        <div class="property-building-head">
                                            <div class="property-object-icon property-object-icon-building">
                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5h10v16M14 9h6v12M7 9h3M7 13h3M7 17h3M17 13h1M17 17h1M2 21h20" /></svg>
                                            </div>
                                            <div class="property-object-title">
                                                <span class="property-object-type">Budynek</span>
                                                <h4>@building.Name</h4>
                                                <p>@building.BuildingType · @building.FunctionType</p>
                                            </div>
                                            <div class="property-object-meta">
                                                <span class="property-status-pill">@building.Status</span>
                                                <small>@buildingRooms.Count pomieszczeń</small>
                                                <button type="button"
                                                        class="property-details-edit-button"
                                                        data-property-details-edit="Building"
                                                        data-property-details-id="@building.Id">
                                                    Edytuj dane
                                                </button>
                                            </div>
                                        </div>

                                        <div class="property-details-summary property-details-summary-building"
                                             data-property-details-summary="Building"
                                             data-property-details-id="@building.Id"></div>
                                        <div class="property-details-editor"
                                             data-property-details-editor="Building"
                                             data-property-details-id="@building.Id"
                                             hidden></div>

                                        @if (buildingMeters.Count > 0)
                                        {
                                            <div class="property-attached-meters property-attached-meters-building">
                                                @foreach (var meter in buildingMeters)
                                                {
                                                    <span class="property-attached-meter">
                                                        <b>@meter.Name</b>
                                                        <small>@(meter.MeterType == MeterTypes.Sub ? (string.Equals(meter.LocationType, "Room", StringComparison.OrdinalIgnoreCase) ? "Podlicznik · rozliczenia lokatorów" : "Podlicznik techniczny") : "Licznik główny") · @meter.Medium · @meter.UnitCode</small>
                                                    </span>
                                                }
                                            </div>
                                        }

                                        @if (buildingRooms.Count == 0)
                                        {
                                            <div class="property-no-rooms">Brak pomieszczeń.</div>
                                        }
                                        else
                                        {
                                            <div class="property-room-grid">
                                                @foreach (var room in buildingRooms)
                                                {
                                                    var roomMeters = Model.Meters
                                                        .Where(x => x.LocationType == "Room" && x.LocationId == room.Id)
                                                        .ToList();

                                                    <article class="property-room-card">
                                                        <div class="property-room-main">
                                                            <span class="property-room-icon">
                                                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM8 20V8h8v12M12 14h.01" /></svg>
                                                            </span>
                                                            <span>
                                                                <strong>@room.Name</strong>
                                                                <small>@room.RoomType</small>
                                                            </span>
                                                        </div>
                                                        <div class="property-room-tags">
                                                            @if (room.IsRentable)
                                                            {
                                                                <span class="property-tag property-tag-accent">Do wynajmu</span>
                                                            }
                                                            @if (room.IsCommonArea)
                                                            {
                                                                <span class="property-tag">Część wspólna</span>
                                                            }
                                                            <span class="property-tag property-tag-status">@room.Status</span>
                                                        </div>

                                                        @if (roomMeters.Count > 0)
                                                        {
                                                            <div class="property-room-meters">
                                                                @foreach (var meter in roomMeters)
                                                                {
                                                                    <span class="property-room-meter">
                                                                        <strong>@meter.Name</strong>
                                                                        <small>@(meter.MeterType == MeterTypes.Sub ? (string.Equals(meter.LocationType, "Room", StringComparison.OrdinalIgnoreCase) ? "Podlicznik · rozliczenia lokatora" : "Podlicznik techniczny") : "Licznik") · @meter.Medium · @meter.UnitCode</small>
                                                                    </span>
                                                                }
                                                            </div>
                                                        }
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }

        <div class="property-actions-grid">
            @if (canCreateParcel)
            {
                <details class="property-action-card">
                    <summary>
                        <span class="property-action-icon">＋</span>
                        <span><strong>Dodaj działkę</strong><small>Nowa lokalizacja główna</small></span>
                        <b>Rozwiń</b>
                    </summary>
                    <div class="property-action-body">
                        <form asp-action="Parcel" method="post" class="property-form-grid">
                            @Html.AntiForgeryToken()
                            <div class="field"><label>Nazwa</label><input name="Name" required /></div>
                            <div class="field"><label>Adres / lokalizacja</label><input name="AddressText" /></div>
                            <div class="field"><label>Nr ewidencyjny</label><input name="RegistryNo" /></div>
                            <div class="field"><label>Powierzchnia m²</label><input name="Area" type="number" step="0.01" min="0" /></div>
                            <div class="field"><label>Rodzaj własności</label><input name="OwnershipType" value="Owned" /></div>
                            <div class="field"><label>Data nabycia</label><input name="AcquiredOn" type="date" /></div>
                            <div class="full property-form-actions"><button class="btn btn-primary" type="submit">Dodaj działkę</button></div>
                        </form>
                    </div>
                </details>
            }

            @if (Model.Parcels.Count > 0)
            {
                <details class="property-action-card">
                    <summary>
                        <span class="property-action-icon">＋</span>
                        <span><strong>Dodaj budynek</strong><small>Przypisz do istniejącej działki</small></span>
                        <b>Rozwiń</b>
                    </summary>
                    <div class="property-action-body">
                        <form asp-action="Building" method="post" class="property-form-grid">
                            @Html.AntiForgeryToken()
                            <div class="field">
                                <label>Działka</label>
                                <select name="ParcelId">
                                    @foreach (var p in Model.Parcels)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Nazwa</label><input name="Name" required /></div>
                            <div class="field">
                                <label>Typ</label>
                                <select name="BuildingType">
                                    <option>Residential</option>
                                    <option>Rental</option>
                                    <option>Mixed</option>
                                    <option>Utility</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Funkcja</label>
                                <select name="FunctionType">
                                    <option>FamilyHome</option>
                                    <option>RentalHouse</option>
                                    <option>Mixed</option>
                                    <option>Utility</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="field"><label>Powierzchnia użytkowa m²</label><input name="UsableArea" type="number" step="0.01" min="0" /></div>
                            <div class="field"><label>Kondygnacje</label><input name="Floors" type="number" min="0" /></div>
                            <div class="field"><label>Rok budowy</label><input name="BuildYear" type="number" min="1000" max="2200" /></div>
                            <div class="full property-form-actions"><button class="btn btn-secondary" type="submit">Dodaj budynek</button></div>
                        </form>
                    </div>
                </details>
            }

            @if (Model.Buildings.Count > 0)
            {
                <details class="property-action-card">
                    <summary>
                        <span class="property-action-icon">＋</span>
                        <span><strong>Dodaj pomieszczenie</strong><small>Pokój lub część wspólna budynku</small></span>
                        <b>Rozwiń</b>
                    </summary>
                    <div class="property-action-body">
                        <form asp-action="Room" method="post" class="property-form-grid">
                            @Html.AntiForgeryToken()
                            <div class="field">
                                <label>Budynek</label>
                                <select name="BuildingId">
                                    @foreach (var b in Model.Buildings)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Nazwa / numer</label><input name="Name" required /></div>
                            <div class="field">
                                <label>Rodzaj</label>
                                <select name="RoomType">
                                    <option>Room</option>
                                    <option>Bathroom</option>
                                    <option>Kitchen</option>
                                    <option>Corridor</option>
                                    <option>Laundry</option>
                                    <option>Basement</option>
                                    <option>Technical</option>
                                    <option>Garage</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="field"><label>Piętro</label><input name="FloorNo" type="number" /></div>
                            <div class="field"><label>Powierzchnia m²</label><input name="Area" type="number" step="0.01" min="0" /></div>
                            <div class="field"><label>Maks. osób</label><input name="Capacity" type="number" min="0" value="1" /></div>
                            <div class="field property-checkbox"><label><input name="IsRentable" type="checkbox" value="true" /> Do wynajmu</label></div>
                            <div class="field property-checkbox"><label><input name="IsCommonArea" type="checkbox" value="true" /> Część wspólna</label></div>
                            <div class="full property-form-actions"><button class="btn btn-primary" type="submit">Dodaj pomieszczenie</button></div>
                        </form>
                    </div>
                </details>

                <details class="property-action-card">
                    <summary>
                        <span class="property-action-icon">↻</span>
                        <span><strong>Zmień status</strong><small>Działka, budynek lub pomieszczenie</small></span>
                        <b>Rozwiń</b>
                    </summary>
                    <div class="property-action-body">
                        <form asp-action="Status" method="post" class="property-form-grid">
                            @Html.AntiForgeryToken()
                            <div class="field">
                                <label>Typ obiektu</label>
                                <select name="ObjectType">
                                    <option>Parcel</option>
                                    <option>Building</option>
                                    <option selected>Room</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Obiekt</label>
                                <select name="Id">
                                    <optgroup label="Działki">
                                        @foreach (var p in Model.Parcels)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Budynki">
                                        @foreach (var b in Model.Buildings)
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Pomieszczenia">
                                        @foreach (var r in Model.Rooms)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="field">
                                <label>Nowy status</label>
                                <select name="NewStatus">
                                    <option>Active</option>
                                    <option>Inactive</option>
                                    <option>Available</option>
                                    <option>Reserved</option>
                                    <option>Rented</option>
                                    <option>Renovation</option>
                                    <option>OutOfService</option>
                                    <option>Archived</option>
                                </select>
                            </div>
                            <div class="field"><label>Powód</label><input name="Reason" required /></div>
                            <div class="full property-info-note">Zmiana statusu tworzy osobny wpis historii. Poprzednia wartość nie jest tracona.</div>
                            <div class="full property-form-actions"><button class="btn btn-secondary" type="submit">Zmień status</button></div>
                        </form>
                    </div>
                </details>
            }
        </div>
    </section>

    @if (canAssets && Model.Rooms.Count > 0)
    {
        <section class="property-section" id="property-assets">
            <div class="property-section-head">
                <div>
                    <div class="property-section-kicker">Majątek gospodarstwa</div>
                    <h2>Wyposażenie</h2>
                    <p>Lista wyposażenia wraz z aktualnym przypisaniem do pomieszczenia.</p>
                </div>
                <span class="property-count-badge">@assetCount elementów</span>
            </div>

            <article class="property-content-card">
                @if (Model.Assets.Count == 0)
                {
                    <div class="property-empty-state property-empty-compact">
                        <strong>Brak wyposażenia</strong>
                        <p>Dodaj pierwszy element wyposażenia i przypisz go do pomieszczenia.</p>
                    </div>
                }
                else
                {
                    <div class="property-table-wrap">
                        <table class="property-table">
                            <thead>
                                <tr>
                                    <th>Wyposażenie</th>
                                    <th>Kategoria</th>
                                    <th>Status</th>
                                    <th>Aktualna lokalizacja</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in Model.Assets)
                                {
                                    var current = Model.AssetAssignments
                                        .Where(x => x.AssetId == asset.Id && x.ValidTo == null)
                                        .OrderByDescending(x => x.ValidFrom)
                                        .FirstOrDefault();
                                    var targetName = current == null
                                        ? "Bez aktywnego przypisania"
                                        : Model.Rooms.FirstOrDefault(x => x.Id == current.TargetId)?.Name ?? current.TargetType;

                                    <tr>
                                        <td><strong>@asset.Name</strong></td>
                                        <td>@asset.CategoryCode</td>
                                        <td><span class="property-status-pill">@asset.Status</span></td>
                                        <td>@targetName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>

            <div class="property-actions-grid property-actions-grid-three">
                <details class="property-action-card">
                    <summary>
                        <span class="property-action-icon">＋</span>
                        <span><strong>Dodaj wyposażenie</strong><small>Nowy sprzęt lub element wyposażenia</small></span>
                        <b>Rozwiń</b>
                    </summary>
                    <div class="property-action-body">
                        <form asp-action="Asset" method="post" class="property-form-grid">
                            @Html.AntiForgeryToken()
                            <div class="field"><label>Nazwa</label><input name="Name" required /></div>
                            <div class="field"><label>Kategoria</label><input name="CategoryCode" value="Equipment" /></div>
                            <div class="field"><label>Producent</label><input name="Manufacturer" /></div>
                            <div class="field"><label>Model</label><input name="Model" /></div>
                            <div class="field"><label>Nr seryjny</label><input name="SerialNo" /></div>
                            <div class="field">
                                <label>Pierwsze przypisanie</label>
                                <select name="RoomId">
                                    @foreach (var r in Model.Rooms)
                                    {
                                        <option value="@r.Id">@r.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="full property-form-actions"><button class="btn btn-primary" type="submit">Dodaj wyposażenie</button></div>
                        </form>
                    </div>
                </details>

                @if (Model.Assets.Count > 0)
                {
                    <details class="property-action-card">
                        <summary>
                            <span class="property-action-icon">→</span>
                            <span><strong>Przenieś</strong><small>Zmień przypisanie do pomieszczenia</small></span>
                            <b>Rozwiń</b>
                        </summary>
                        <div class="property-action-body">
                            <form asp-action="AssetAssignment" method="post" class="property-form-grid">
                                @Html.AntiForgeryToken()
                                <div class="field">
                                    <label>Wyposażenie</label>
                                    <select name="AssetId">
                                        @foreach (var a in Model.Assets.Where(x => x.Status == AssetStatuses.Active))
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Nowe pomieszczenie</label>
                                    <select name="RoomId">
                                        @foreach (var r in Model.Rooms)
                                        {
                                            <option value="@r.Id">@r.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Od</label><input name="ValidFrom" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></div>
                                <div class="field"><label>Stan przy przekazaniu</label><input name="ConditionAtStart" value="Good" /></div>
                                <div class="full property-form-actions"><button class="btn btn-secondary" type="submit">Przenieś wyposażenie</button></div>
                            </form>
                        </div>
                    </details>

                    <details class="property-action-card">
                        <summary>
                            <span class="property-action-icon">×</span>
                            <span><strong>Wycofaj</strong><small>Zakończ aktywne użytkowanie</small></span>
                            <b>Rozwiń</b>
                        </summary>
                        <div class="property-action-body">
                            <form asp-action="AssetWithdraw" method="post" class="property-form-grid">
                                @Html.AntiForgeryToken()
                                <div class="field">
                                    <label>Wyposażenie</label>
                                    <select name="AssetId">
                                        @foreach (var a in Model.Assets.Where(x => x.Status == AssetStatuses.Active))
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Data wycofania</label><input name="EndedOn" type="date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /></div>
                                <div class="field full"><label>Stan końcowy</label><input name="ConditionAtEnd" /></div>
                                <div class="full property-form-actions"><button class="btn btn-secondary" type="submit">Wycofaj</button></div>
                            </form>
                        </div>
                    </details>
                }
            </div>
        </section>
    }

    @if (canMeters && Model.Parcels.Count > 0)
    {
        <section class="property-section" id="property-meters">
            <div class="property-section-head">
                <div>
                    <div class="property-section-kicker">Media i pomiary</div>
                    <h2>Liczniki i podliczniki</h2>
                    <p>Liczniki główne przypisujesz do działki lub domu. Podlicznik może być techniczny dla działki/domu albo lokatorski dla konkretnego pokoju/lokalu do wynajmu.</p>
                </div>
                <span class="property-count-badge">@meterCount liczników</span>
            </div>

            <article class="property-content-card">
                @if (Model.Meters.Count == 0)
                {
                    <div class="property-empty-state property-empty-compact">
                        <strong>Brak liczników</strong>
                        <p>Dodaj pierwszy licznik główny, a później możesz tworzyć podliczniki.</p>
                    </div>
                }
                else
                {
                    <div class="property-meter-list">
                        @foreach (var meter in Model.Meters)
                        {
                            var parent = meter.ParentMeterId.HasValue
                                ? Model.Meters.FirstOrDefault(x => x.Id == meter.ParentMeterId.GetValueOrDefault())?.Name
                                : null;
                            var mediumLabel = meter.Medium switch
                            {
                                "Electricity" => "Prąd",
                                "Water" => "Woda",
                                "Gas" => "Gaz",
                                "Heating" => "Ogrzewanie",
                                _ => "Inne"
                            };
                            var typeLabel = meter.MeterType == MeterTypes.Sub ? "Podlicznik" : "Główny";
                            var unitLabel = meter.UnitCode switch
                            {
                                "m3" => "m³",
                                "szt" => "szt.",
                                "unit" => "jednostka",
                                _ => meter.UnitCode
                            };

                            <div class="property-meter-item">
                                <div class="property-meter-row">
                                    <span class="property-meter-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V8a8 8 0 0 1 16 0v12M8 16a4 4 0 1 1 8 0M12 12v4l3 1" /></svg>
                                    </span>
                                    <span class="property-meter-copy">
                                        <strong>@meter.Name</strong>
                                        <small>@mediumLabel · @typeLabel · @unitLabel</small>
                                    </span>
                                    @{
                                        var meterParcel = meter.LocationType == "Parcel"
                                            ? Model.Parcels.FirstOrDefault(x => x.Id == meter.LocationId)
                                            : null;
                                        var meterRoom = meter.LocationType == "Room"
                                            ? Model.Rooms.FirstOrDefault(x => x.Id == meter.LocationId)
                                            : null;
                                        var meterBuilding = meter.LocationType == "Building"
                                            ? Model.Buildings.FirstOrDefault(x => x.Id == meter.LocationId)
                                            : meterRoom is not null
                                                ? Model.Buildings.FirstOrDefault(x => x.Id == meterRoom.BuildingId)
                                                : null;
                                        var meterPath = meter.LocationType switch
                                        {
                                            "Parcel" => meterParcel?.Name ?? "Działka",
                                            "Building" => meterBuilding?.Name ?? "Budynek",
                                            "Room" => $"{meterBuilding?.Name ?? "Dom"} → {meterRoom?.Name ?? "Pokój"}",
                                            _ => meter.LocationType
                                        };
                                    }
                                    <span class="property-meter-location">
                                        <strong>@meterPath</strong>
                                        <small>
                                            @(meter.MeterType == MeterTypes.Sub
                                                ? $"Rozliczenia lokatorów · nadrzędny: {parent ?? "brak"}"
                                                : "Licznik główny")
                                        </small>
                                    </span>
                                    <button type="button"
                                            class="property-meter-edit-button"
                                            data-meter-edit-toggle="@meter.Id"
                                            aria-expanded="false">
                                        Edytuj
                                    </button>
                                </div>

                                <div class="property-meter-edit-panel" id="meter-edit-@meter.Id" hidden>
                                    <div class="property-meter-edit-head">
                                        <div>
                                            <strong>Edycja licznika: @meter.Name</strong>
                                            <small>Jednostka jest ograniczona do wartości zgodnych z wybranym medium.</small>
                                        </div>
                                        <button type="button" data-meter-edit-close="@meter.Id">Zamknij ×</button>
                                    </div>

                                    <form asp-controller="PropertyMeterConfiguration"
                                          asp-action="Edit"
                                          method="post"
                                          class="property-form-grid property-meter-config-form"
                                          data-meter-config-form>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="meterId" value="@meter.Id" />

                                        <div class="field">
                                            <label>Nazwa</label>
                                            <input name="name" value="@meter.Name" required />
                                        </div>

                                        <div class="field">
                                            <label>Medium</label>
                                            <select name="medium"
                                                    data-meter-medium
                                                    data-current-value="@meter.Medium">
                                                <option value="Electricity">Prąd</option>
                                                <option value="Water">Woda</option>
                                                <option value="Gas">Gaz</option>
                                                <option value="Heating">Ogrzewanie</option>
                                                <option value="Other">Inne</option>
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Typ licznika</label>
                                            <select name="meterType"
                                                    data-meter-type
                                                    data-current-value="@meter.MeterType">
                                                <option value="Main">Główny</option>
                                                <option value="Sub">Podlicznik</option>
                                            </select>
                                        </div>

                                        <div class="field">
                                            <label>Jednostka</label>
                                            <select name="unitCode"
                                                    data-meter-unit
                                                    data-current-unit="@meter.UnitCode"></select>
                                        </div>

                                        <div class="field full">
                                            <label>Lokalizacja licznika</label>
                                            <select data-meter-location
                                                    data-current-location-type="@meter.LocationType"
                                                    data-current-location-id="@meter.LocationId">
                                                <optgroup label="Działki — licznik główny lub podlicznik techniczny">
                                                    @foreach (var p in Model.Parcels)
                                                    {
                                                        <option value="@p.Id"
                                                                data-location-type="Parcel"
                                                                data-parcel-id="@p.Id"
                                                                data-allowed-type="Main,Sub">
                                                            Działka: @p.Name
                                                        </option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Domy / budynki — licznik główny lub podlicznik techniczny">
                                                    @foreach (var b in Model.Buildings)
                                                    {
                                                        <option value="@b.Id"
                                                                data-location-type="Building"
                                                                data-building-id="@b.Id"
                                                                data-parcel-id="@b.ParcelId"
                                                                data-allowed-type="Main,Sub">
                                                            Dom: @b.Name
                                                        </option>
                                                    }
                                                </optgroup>
                                                <optgroup label="Pokoje/lokale do wynajmu — podliczniki lokatorów">
                                                    @foreach (var r in Model.Rooms.Where(x => x.IsRentable))
                                                    {
                                                        var rb = Model.Buildings.FirstOrDefault(x => x.Id == r.BuildingId);
                                                        <option value="@r.Id"
                                                                data-location-type="Room"
                                                                data-building-id="@r.BuildingId"
                                                                data-parcel-id="@rb?.ParcelId"
                                                                data-allowed-type="Sub">
                                                            @(rb?.Name ?? "Dom") → @r.Name
                                                        </option>
                                                    }
                                                </optgroup>
                                            </select>
                                            <input type="hidden" name="locationType" data-meter-location-type />
                                            <input type="hidden" name="locationId" data-meter-location-id />
                                            <small class="property-field-help">
                                                Podlicznik techniczny może być przypisany do działki lub domu. Jeśli przypiszesz go do pokoju/lokalu „Do wynajmu”, będzie mógł służyć do rozliczeń lokatora.
                                            </small>
                                        </div>

                                        <div class="field full">
                                            <label>Licznik nadrzędny</label>
                                            <select name="parentMeterId"
                                                    data-meter-parent
                                                    data-current-parent="@(meter.ParentMeterId?.ToString("D") ?? "")">
                                                <option value="">— brak —</option>
                                                @foreach (var main in Model.Meters.Where(x => x.MeterType == MeterTypes.Main && x.Status == MeterStatuses.Active))
                                                {
                                                    <option value="@main.Id"
                                                            data-medium="@main.Medium"
                                                            data-location-type="@main.LocationType"
                                                            data-location-id="@main.LocationId">
                                                        @main.Name · @main.Medium
                                                    </option>
                                                }
                                            </select>
                                            <small class="property-field-help">Dla licznika głównego pole jest automatycznie wyłączone. Podlicznik wskazuje aktywny licznik główny tego samego medium i z tej samej działki/gałęzi domu.</small>
                                        </div>

                                        <div class="full property-meter-unit-warning">
                                            Zmiana jednostki dotyczy bieżącej konfiguracji licznika i przyszłych odczytów. Historyczne odczyty zachowują własną jednostkę; po zmianie sprawdź także stawki/taryfy powiązane z tym licznikiem.
                                        </div>

                                        <div class="full property-form-actions">
                                            <button class="btn btn-primary" type="submit">Zapisz licznik</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>

            <details class="property-action-card property-action-wide">
                <summary>
                    <span class="property-action-icon">＋</span>
                    <span><strong>Dodaj licznik lub podlicznik</strong><small>Wybierz medium, lokalizację i ewentualny licznik nadrzędny</small></span>
                    <b>Rozwiń</b>
                </summary>
                <div class="property-action-body">
                    <div class="property-meter-rule-note">
                        <strong>Zasada e-dom:</strong>
                        licznik główny może obejmować całą działkę albo konkretny dom.
                        Podlicznik możesz przypisać do działki, domu albo — dla rozliczeń lokatora — do pokoju/lokalu oznaczonego „Do wynajmu”.
                    </div>
                    <form asp-action="Meter" method="post" class="property-form-grid property-form-grid-four" id="meter-form">
                        @Html.AntiForgeryToken()
                        <div class="field"><label>Nazwa</label><input name="Name" required /></div>
                        <div class="field">
                            <label>Medium</label>
                            <select name="Medium" data-meter-medium data-current-value="Electricity">
                                <option value="Electricity">Prąd</option>
                                <option value="Water">Woda</option>
                                <option value="Gas">Gaz</option>
                                <option value="Heating">Ogrzewanie</option>
                                <option value="Other">Inne</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Typ</label>
                            <select name="MeterType" data-meter-type data-current-value="Main">
                                <option value="Main">Główny</option>
                                <option value="Sub">Podlicznik</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Jednostka</label>
                            <select name="UnitCode" data-meter-unit data-current-unit="kWh"></select>
                        </div>
                        <div class="field">
                            <label>Lokalizacja</label>
                            <select data-meter-location>
                                <optgroup label="Działki — licznik główny lub podlicznik techniczny">
                                    @foreach (var p in Model.Parcels)
                                    {
                                        <option value="@p.Id"
                                                data-location-type="Parcel"
                                                data-parcel-id="@p.Id"
                                                data-allowed-type="Main,Sub">
                                            Działka: @p.Name
                                        </option>
                                    }
                                </optgroup>
                                <optgroup label="Domy / budynki — licznik główny lub podlicznik techniczny">
                                    @foreach (var b in Model.Buildings)
                                    {
                                        <option value="@b.Id"
                                                data-location-type="Building"
                                                data-building-id="@b.Id"
                                                data-parcel-id="@b.ParcelId"
                                                data-allowed-type="Main,Sub">
                                            Dom: @b.Name
                                        </option>
                                    }
                                </optgroup>
                                <optgroup label="Pokoje/lokale do wynajmu — podliczniki lokatorów">
                                    @foreach (var r in Model.Rooms.Where(x => x.IsRentable))
                                    {
                                        var rb = Model.Buildings.FirstOrDefault(x => x.Id == r.BuildingId);
                                        <option value="@r.Id"
                                                data-location-type="Room"
                                                data-building-id="@r.BuildingId"
                                                data-parcel-id="@rb?.ParcelId"
                                                data-allowed-type="Sub">
                                            @(rb?.Name ?? "Dom") → @r.Name
                                        </option>
                                    }
                                </optgroup>
                            </select>
                            <input type="hidden" name="LocationType" data-meter-location-type />
                            <input type="hidden" name="LocationId" data-meter-location-id />
                            <small class="property-field-help">
                                Główny: działka lub dom. Podlicznik: działka, dom albo pokój/lokal do wynajmu.
                            </small>
                        </div>
                        <div class="field">
                            <label>Licznik nadrzędny (dla podlicznika)</label>
                            <select name="ParentMeterId" data-meter-parent>
                                <option value="">— brak —</option>
                                @foreach (var m in Model.Meters.Where(x => x.MeterType == MeterTypes.Main && x.Status == MeterStatuses.Active))
                                {
                                    <option value="@m.Id"
                                            data-medium="@m.Medium"
                                            data-location-type="@m.LocationType"
                                            data-location-id="@m.LocationId">
                                        @m.Name · @m.Medium
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="field"><label>Nr seryjny</label><input name="SerialNo" /></div>
                        <div class="field"><label>Data montażu</label><input name="InstalledOn" type="date" /></div>
                        <div class="full property-form-actions"><button class="btn btn-primary" type="submit">Dodaj licznik</button></div>
                    </form>
                </div>
            </details>
        </section>
    }

    <section class="property-section" id="property-manage">
        <div class="property-section-head">
            <div>
                <div class="property-section-kicker">Administracja danymi</div>
                <h2>Edycja i archiwizacja</h2>
                <p>Zmiana danych zachowuje historię statusów. „Usuń” dla obiektów użytych w systemie oznacza archiwizację.</p>

        </div>

        <div class="property-actions-grid">
            <details class="property-action-card">
                <summary>
                    <span class="property-action-icon">✎</span>
                    <span><strong>Edytuj obiekt</strong><small>Zmień nazwę i podstawowe dane</small></span>
                    <b>Rozwiń</b>
                </summary>
                <div class="property-action-body">
                    <form asp-action="UpdateRecord" method="post" class="property-form-grid" id="property-edit-form">
                        @Html.AntiForgeryToken()
                        <div class="field full">
                            <label>Obiekt</label>
                            <small class="property-field-help">Liczniki edytujesz bezpośrednio w sekcji „Liczniki i podliczniki”.</small>
                            <select id="property-edit-object" required>
                                @foreach (var x in Model.Parcels)
                                {
                                    <option data-type="Parcel" value="@x.Id">Działka: @x.Name</option>
                                }
                                @foreach (var x in Model.Buildings)
                                {
                                    <option data-type="Building" value="@x.Id">Budynek: @x.Name</option>
                                }
                                @foreach (var x in Model.Rooms)
                                {
                                    <option data-type="Room" value="@x.Id">Pomieszczenie: @x.Name</option>
                                }
                                @foreach (var x in Model.Assets)
                                {
                                    <option data-type="Asset" value="@x.Id">Wyposażenie: @x.Name</option>
                                }
                            </select>
                            <input type="hidden" name="RecordType" id="property-edit-type" />
                            <input type="hidden" name="RecordId" id="property-edit-id" />
                        </div>
                        <div class="field"><label>Nowa nazwa</label><input name="Name" required /></div>
                        <div class="field"><label>Typ / adres / kategoria / nr seryjny</label><input name="SecondaryText" /></div>
                        <div class="field"><label>Powierzchnia m²</label><input name="Area" type="number" step="0.01" /></div>
                        <div class="field"><label>Liczba (np. piętra / pojemność)</label><input name="NumberValue" type="number" /></div>
                        <div class="full property-form-actions"><button class="btn btn-primary" type="submit">Zapisz edycję</button></div>
                    </form>
                </div>
            </details>

            <details class="property-action-card property-action-danger">
                <summary>
                    <span class="property-action-icon">×</span>
                    <span><strong>Usuń / archiwizuj</strong><small>Bezpieczne wycofanie obiektu z aktywnego użycia</small></span>
                    <b>Rozwiń</b>
                </summary>
                <div class="property-action-body">
                    <form asp-action="ArchiveRecord" method="post" class="property-form-grid" id="property-archive-form">
                        @Html.AntiForgeryToken()
                        <div class="field full">
                            <label>Obiekt</label>
                            <select id="property-archive-object" required>
                                @foreach (var x in Model.Parcels)
                                {
                                    <option data-type="Parcel" value="@x.Id">Działka: @x.Name</option>
                                }
                                @foreach (var x in Model.Buildings)
                                {
                                    <option data-type="Building" value="@x.Id">Budynek: @x.Name</option>
                                }
                                @foreach (var x in Model.Rooms)
                                {
                                    <option data-type="Room" value="@x.Id">Pomieszczenie: @x.Name</option>
                                }
                                @foreach (var x in Model.Assets)
                                {
                                    <option data-type="Asset" value="@x.Id">Wyposażenie: @x.Name</option>
                                }
                                @foreach (var x in Model.Meters)
                                {
                                    <option data-type="Meter" value="@x.Id">Licznik: @x.Name</option>
                                }
                            </select>
                            <input type="hidden" name="recordType" id="property-archive-type" />
                            <input type="hidden" name="recordId" id="property-archive-id" />
                        </div>
                        <div class="field full"><label>Powód</label><input name="reason" value="Archiwizacja / usunięcie logiczne" required /></div>
                        <div class="full property-info-note property-info-warning">Archiwizacja zachowuje historię obiektu i jego wcześniejsze powiązania.</div>
                        <div class="full property-form-actions"><button class="btn btn-danger" type="submit">Usuń / archiwizuj</button></div>
                    </form>
                </div>
            </details>
        </div>
    </section>
</div>

<script>
(() => {
    const bindRecordSelect = (selectId, typeId, idId) => {
        const select = document.getElementById(selectId);
        const type = document.getElementById(typeId);
        const id = document.getElementById(idId);

        if (!select || !type || !id || select.options.length === 0) return;

        const sync = () => {
            const option = select.options[select.selectedIndex];
            type.value = option.dataset.type || '';
            id.value = option.value || '';
        };

        select.addEventListener('change', sync);
        sync();
    };

    bindRecordSelect('property-edit-object', 'property-edit-type', 'property-edit-id');
    bindRecordSelect('property-archive-object', 'property-archive-type', 'property-archive-id');

    const meterUnits = {
        Electricity: [
            { value: 'kWh', label: 'kWh' },
            { value: 'MWh', label: 'MWh' },
            { value: 'Wh', label: 'Wh' }
        ],
        Water: [
            { value: 'm3', label: 'm³' },
            { value: 'l', label: 'l' }
        ],
        Gas: [
            { value: 'm3', label: 'm³' },
            { value: 'kWh', label: 'kWh' }
        ],
        Heating: [
            { value: 'kWh', label: 'kWh' },
            { value: 'MWh', label: 'MWh' },
            { value: 'GJ', label: 'GJ' }
        ],
        Other: [
            { value: 'unit', label: 'jednostka' },
            { value: 'szt', label: 'szt.' },
            { value: 'm3', label: 'm³' },
            { value: 'l', label: 'l' },
            { value: 'kWh', label: 'kWh' }
        ]
    };

    const normalizeUnit = value => {
        if (value === 'm³' || value === 'M3') return 'm3';
        if (value === 'L') return 'l';
        if (value === 'szt.') return 'szt';
        return value || '';
    };

    const bindMeterConfig = form => {
        const medium = form.querySelector('[data-meter-medium]');
        const type = form.querySelector('[data-meter-type]');
        const unit = form.querySelector('[data-meter-unit]');
        const parent = form.querySelector('[data-meter-parent]');
        const location = form.querySelector('[data-meter-location]');
        const locationType = form.querySelector('[data-meter-location-type]');
        const locationId = form.querySelector('[data-meter-location-id]');
        if (!medium || !type || !unit || !parent || !location || !locationType || !locationId) return;

        if (medium.dataset.currentValue) medium.value = medium.dataset.currentValue;
        if (type.dataset.currentValue) type.value = type.dataset.currentValue;

        const desiredUnit = normalizeUnit(unit.dataset.currentUnit || unit.value || '');
        const desiredParent = parent.dataset.currentParent || parent.value || '';
        const desiredLocationType = location.dataset.currentLocationType || '';
        const desiredLocationId = location.dataset.currentLocationId || '';

        const currentLocationOption = () =>
            location.options[location.selectedIndex] || null;

        const syncLocationHidden = () => {
            const option = currentLocationOption();
            locationType.value = option?.dataset.locationType || '';
            locationId.value = option?.value || '';
        };

        const refreshUnits = preserve => {
            const options = meterUnits[medium.value] || meterUnits.Other;
            const previous = preserve ? normalizeUnit(unit.value) : desiredUnit;
            unit.innerHTML = '';

            options.forEach(item => {
                const option = document.createElement('option');
                option.value = item.value;
                option.textContent = item.label;
                unit.appendChild(option);
            });

            const allowed = options.some(item => item.value === previous);
            unit.value = allowed ? previous : options[0].value;
        };

        const refreshLocations = preserve => {
            const wantedType = type.value === 'Sub' ? 'Sub' : 'Main';
            const previousValue = preserve ? location.value : desiredLocationId;
            const previousType = preserve
                ? currentLocationOption()?.dataset.locationType || ''
                : desiredLocationType;

            let firstVisible = null;
            let selected = null;

            Array.from(location.options).forEach(option => {
                const allowedTypes = (option.dataset.allowedType || '')
                    .split(',')
                    .map(value => value.trim())
                    .filter(Boolean);

                const visible = allowedTypes.includes(wantedType);
                option.hidden = !visible;
                option.disabled = !visible;

                if (visible && !firstVisible) firstVisible = option;
                if (visible
                    && option.value === previousValue
                    && (!previousType || option.dataset.locationType === previousType)) {
                    selected = option;
                }
            });

            const target = selected || firstVisible;
            if (target) {
                location.value = target.value;
                target.selected = true;
            }

            syncLocationHidden();
        };

        const parentCoversLocation = (parentOption, locationOption) => {
            if (!parentOption?.value || !locationOption) return false;

            if (parentOption.dataset.locationType === 'Parcel') {
                return parentOption.dataset.locationId === locationOption.dataset.parcelId;
            }

            if (parentOption.dataset.locationType === 'Building') {
                return parentOption.dataset.locationId === locationOption.dataset.buildingId;
            }

            return false;
        };

        const refreshParent = preserve => {
            const isSub = type.value === 'Sub';
            parent.disabled = !isSub;

            const locationOption = currentLocationOption();
            let firstVisible = null;

            Array.from(parent.options).forEach(option => {
                if (!option.value) {
                    option.hidden = false;
                    option.disabled = !isSub;
                    return;
                }

                const visible = isSub
                    && option.dataset.medium === medium.value
                    && parentCoversLocation(option, locationOption);

                option.hidden = !visible;
                option.disabled = !visible;
                if (visible && !firstVisible) firstVisible = option;
            });

            if (!isSub) {
                parent.value = '';
                return;
            }

            const wanted = preserve ? parent.value : desiredParent;
            const wantedOption = Array.from(parent.options).find(option =>
                option.value === wanted && !option.hidden && !option.disabled);

            parent.value = wantedOption
                ? wanted
                : firstVisible?.value || '';
        };

        medium.addEventListener('change', () => {
            refreshUnits(true);
            refreshParent(true);
        });

        type.addEventListener('change', () => {
            refreshLocations(true);
            refreshParent(false);
        });

        location.addEventListener('change', () => {
            syncLocationHidden();
            refreshParent(true);
        });

        refreshUnits(false);
        refreshLocations(false);
        refreshParent(false);
    };

    document.querySelectorAll('[data-meter-config-form], #meter-form').forEach(bindMeterConfig);

    const setMeterEditor = (id, open) => {
        const panel = document.getElementById('meter-edit-' + id);
        const toggle = document.querySelector('[data-meter-edit-toggle="' + id + '"]');
        if (!panel) return;

        panel.hidden = !open;
        toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle?.classList.toggle('is-open', open);
    };

    document.querySelectorAll('[data-meter-edit-toggle]').forEach(button => {
        button.addEventListener('click', () => {
            const id = button.dataset.meterEditToggle;
            const panel = document.getElementById('meter-edit-' + id);
            if (!panel) return;

            const open = panel.hidden;

            document.querySelectorAll('.property-meter-edit-panel:not([hidden])').forEach(other => {
                if (other !== panel) {
                    other.hidden = true;
                    const otherId = other.id.replace('meter-edit-', '');
                    const otherToggle = document.querySelector('[data-meter-edit-toggle="' + otherId + '"]');
                    otherToggle?.setAttribute('aria-expanded', 'false');
                    otherToggle?.classList.remove('is-open');
                }
            });

            setMeterEditor(id, open);
        });
    });

    document.querySelectorAll('[data-meter-edit-close]').forEach(button => {
        button.addEventListener('click', () => setMeterEditor(button.dataset.meterEditClose, false));
    });
})();
</script>

<script src="~/js/property-details-ui.js" asp-append-version="true"></script>

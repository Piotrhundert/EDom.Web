@using System.Linq
@model IReadOnlyList<ModuleDefinition>
@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var currentKey = (ViewContext.RouteData.Values["key"] as string) ?? Context.Request.Query["key"].ToString();

    Func<string, string> iconForKey = key =>
    {
        return (key ?? string.Empty).ToLowerInvariant() switch
        {
            "household" => "OS",
            "private-finance" => "MF",
            "household-finance" => "BF",
            "documents" => "DO",
            "calendar" => "KA",
            "property" => "NI",
            "rental" => "NA",
            "user-management" => "UA",
            _ => string.IsNullOrWhiteSpace(key) ? "MD" : new string(key.Where(char.IsLetterOrDigit).Take(2).ToArray()).ToUpperInvariant()
        };
    };

    Func<ModuleDefinition, string> sectionFor = module =>
    {
        var key = (module.Key ?? string.Empty).ToLowerInvariant();
        if (key is "household" or "user-management") return "Gospodarstwo";
        if (key.Contains("finance")) return "Finanse";
        if (key is "documents" or "calendar") return "Współpraca";
        if (key is "property" or "rental" or "utilities") return "Nieruchomości i najem";
        return "Pozostałe";
    };

    var groups = Model
        .GroupBy(sectionFor)
        .OrderBy(group => group.Key switch
        {
            "Gospodarstwo" => 1,
            "Finanse" => 2,
            "Współpraca" => 3,
            "Nieruchomości i najem" => 4,
            _ => 9
        })
        .ToList();
}

<nav class="main-nav" aria-label="Główna nawigacja">
    <div class="nav-section">
        <div class="sidebar-caption">Start</div>
        <a class="nav-item @((currentPath == "/" || currentPath.StartsWith("/Home")) ? "active" : string.Empty)" asp-controller="Home" asp-action="Index">
            <span class="nav-icon">PU</span>
            <span class="nav-copy">
                <strong>Pulpit</strong>
                <small>Szybki przegląd i wejście do modułów</small>
            </span>
        </a>
    </div>

    @foreach (var group in groups)
    {
        <div class="nav-section">
            <div class="sidebar-caption">@group.Key</div>
            @foreach (var module in group)
            {
                var routePrefix = module.Key switch
                {
                    "household" => "/Household",
                    "private-finance" => "/PrivateFinance",
                    "finances" => "/HouseholdFinance",
                    "property" => "/Property",
                    "rental" => "/Rental",
                    "utilities" => "/Utilities",
                    "calendar" => "/Calendar",
                    "documents" => "/Documents",
                    "settings" => "/UserManagement",
                    _ => "/module/" + module.Key
                };
                var isActive = string.Equals(currentKey, module.Key, StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith(routePrefix, StringComparison.OrdinalIgnoreCase);
                <a class="nav-item @(isActive ? "active" : string.Empty)" asp-controller="Modules" asp-action="Index" asp-route-key="@module.Key">
                    <span class="nav-icon">@iconForKey(module.Key)</span>
                    <span class="nav-copy">
                        <strong>@module.Label</strong>
                        <small>@module.Description</small>
                    </span>
                </a>
            }
        </div>
    }
</nav>
